<Application x:Class="Layal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Layal.Services"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <services:TextDirectionConverter x:Key="Layal.TextDirectionConverter" />

        <!-- Layal Calm Light design system: soft surfaces, strong text contrast, restrained accents. -->
        <Color x:Key="Layal.Color.Background">#F4F7FC</Color>
        <Color x:Key="Layal.Color.BackgroundEnd">#EEF3FB</Color>
        <Color x:Key="Layal.Color.Surface">#FFFFFF</Color>
        <Color x:Key="Layal.Color.SurfaceRaised">#FAFBFF</Color>
        <Color x:Key="Layal.Color.SurfaceHover">#EDF3FA</Color>
        <Color x:Key="Layal.Color.Border">#DCE5F0</Color>
        <Color x:Key="Layal.Color.Cyan">#087B8F</Color>
        <Color x:Key="Layal.Color.Purple">#7563D6</Color>
        <Color x:Key="Layal.Color.Text">#1C2940</Color>
        <Color x:Key="Layal.Color.Muted">#5D6D84</Color>
        <Color x:Key="Layal.Color.ScrollThumb">#9BAEC7</Color>
        <Color x:Key="Layal.Color.Success">#177A57</Color>
        <Color x:Key="Layal.Color.Warning">#946200</Color>
        <Color x:Key="Layal.Color.Danger">#BD3C55</Color>
        <Color x:Key="Layal.Color.Focus">#AFC8F7</Color>
        <Color x:Key="Layal.Color.HeaderStart">#EAF5FF</Color>
        <Color x:Key="Layal.Color.HeaderMiddle">#FFFFFF</Color>
        <Color x:Key="Layal.Color.HeaderEnd">#F3EFFF</Color>
        <Color x:Key="Layal.Color.CardStart">#FFFFFF</Color>
        <Color x:Key="Layal.Color.CardEnd">#F9FBFF</Color>
        <Color x:Key="Layal.Color.ButtonStart">#A3E3E7</Color>
        <Color x:Key="Layal.Color.ButtonEnd">#C8C0F7</Color>
        <Color x:Key="Layal.Color.BrandBorder">#B9E6EB</Color>
        <Color x:Key="Layal.Color.BrandDot">#E8B451</Color>
        <Color x:Key="Layal.Color.DangerSurface">#FBECEF</Color>
        <Color x:Key="Layal.Color.DangerBorder">#E9C3CC</Color>
        <Color x:Key="Layal.Color.NavSelected">#E2F2F6</Color>
        <Color x:Key="Layal.Color.NavSelectedBorder">#C6E8ED</Color>
        <Color x:Key="Layal.Color.NavHover">#F0F5FC</Color>
        <Color x:Key="Layal.Color.ListHover">#F0F6FC</Color>
        <Color x:Key="Layal.Color.ListSelected">#E3F3F6</Color>
        <Color x:Key="Layal.Color.InputFocus">#FBFDFF</Color>
        <Color x:Key="Layal.Color.HoverSurface">#E8F5F7</Color>
        <Color x:Key="Layal.Color.Shadow">#A8B9D6</Color>
        <!-- The aurora is intentionally more saturated so the frosted surfaces read as glass, not flat white cards. -->
        <Color x:Key="Layal.Color.BackdropStart">#899DF4</Color>
        <Color x:Key="Layal.Color.BackdropMiddle">#B09AEF</Color>
        <Color x:Key="Layal.Color.BackdropEnd">#F1B4D2</Color>
        <Color x:Key="Layal.Color.Glass">#99FFFFFF</Color>
        <Color x:Key="Layal.Color.GlassStrong">#E0FFFFFF</Color>
        <Color x:Key="Layal.Color.GlassBorder">#D0FFFFFF</Color>
        <Color x:Key="Layal.Color.GlowBlue">#98637AFB</Color>
        <Color x:Key="Layal.Color.GlowViolet">#8E9A60F0</Color>
        <Color x:Key="Layal.Color.GlowPink">#88EF78B9</Color>
        <Color x:Key="Layal.Color.AccentStart">#4A66DE</Color>
        <Color x:Key="Layal.Color.AccentEnd">#7A50D4</Color>
        <Color x:Key="Layal.Color.OnAccent">#FFFFFF</Color>

        <SolidColorBrush x:Key="Layal.Background" Color="{DynamicResource Layal.Color.Background}" />
        <SolidColorBrush x:Key="Layal.Panel" Color="{DynamicResource Layal.Color.Surface}" />
        <SolidColorBrush x:Key="Layal.PanelAlt" Color="{DynamicResource Layal.Color.SurfaceRaised}" />
        <SolidColorBrush x:Key="Layal.PanelHover" Color="{DynamicResource Layal.Color.SurfaceHover}" />
        <SolidColorBrush x:Key="Layal.Border" Color="{DynamicResource Layal.Color.Border}" />
        <SolidColorBrush x:Key="Layal.Cyan" Color="{DynamicResource Layal.Color.Cyan}" />
        <SolidColorBrush x:Key="Layal.Purple" Color="{DynamicResource Layal.Color.Purple}" />
        <SolidColorBrush x:Key="Layal.Text" Color="{DynamicResource Layal.Color.Text}" />
        <SolidColorBrush x:Key="Layal.Muted" Color="{DynamicResource Layal.Color.Muted}" />
        <SolidColorBrush x:Key="Layal.ScrollThumb" Color="{DynamicResource Layal.Color.ScrollThumb}" />
        <SolidColorBrush x:Key="Layal.Success" Color="{DynamicResource Layal.Color.Success}" />
        <SolidColorBrush x:Key="Layal.Warning" Color="{DynamicResource Layal.Color.Warning}" />
        <SolidColorBrush x:Key="Layal.Danger" Color="{DynamicResource Layal.Color.Danger}" />
        <SolidColorBrush x:Key="Layal.Focus" Color="{DynamicResource Layal.Color.Focus}" />
        <SolidColorBrush x:Key="Layal.White" Color="{DynamicResource Layal.Color.Surface}" />
        <SolidColorBrush x:Key="Layal.BrandBorder" Color="{DynamicResource Layal.Color.BrandBorder}" />
        <SolidColorBrush x:Key="Layal.DecorativeAmber" Color="{DynamicResource Layal.Color.BrandDot}" />
        <SolidColorBrush x:Key="Layal.DangerSurface" Color="{DynamicResource Layal.Color.DangerSurface}" />
        <SolidColorBrush x:Key="Layal.DangerBorder" Color="{DynamicResource Layal.Color.DangerBorder}" />
        <SolidColorBrush x:Key="Layal.HoverSurface" Color="{DynamicResource Layal.Color.HoverSurface}" />
        <SolidColorBrush x:Key="Layal.InputFocus" Color="{DynamicResource Layal.Color.InputFocus}" />
        <SolidColorBrush x:Key="Layal.ListHover" Color="{DynamicResource Layal.Color.ListHover}" />
        <SolidColorBrush x:Key="Layal.ListSelected" Color="{DynamicResource Layal.Color.ListSelected}" />
        <SolidColorBrush x:Key="Layal.NavSelected" Color="{DynamicResource Layal.Color.NavSelected}" />
        <SolidColorBrush x:Key="Layal.NavSelectedBorder" Color="{DynamicResource Layal.Color.NavSelectedBorder}" />
        <SolidColorBrush x:Key="Layal.NavHover" Color="{DynamicResource Layal.Color.NavHover}" />
        <SolidColorBrush x:Key="Layal.GlassFill" Color="{DynamicResource Layal.Color.Glass}" />
        <SolidColorBrush x:Key="Layal.GlassStrongFill" Color="{DynamicResource Layal.Color.GlassStrong}" />
        <SolidColorBrush x:Key="Layal.GlassBorderBrush" Color="{DynamicResource Layal.Color.GlassBorder}" />
        <SolidColorBrush x:Key="Layal.GlowBlueBrush" Color="{DynamicResource Layal.Color.GlowBlue}" />
        <SolidColorBrush x:Key="Layal.GlowVioletBrush" Color="{DynamicResource Layal.Color.GlowViolet}" />
        <SolidColorBrush x:Key="Layal.GlowPinkBrush" Color="{DynamicResource Layal.Color.GlowPink}" />
        <SolidColorBrush x:Key="Layal.OnAccent" Color="{DynamicResource Layal.Color.OnAccent}" />

        <LinearGradientBrush x:Key="Layal.HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Layal.Color.HeaderStart}" Offset="0" />
            <GradientStop Color="{DynamicResource Layal.Color.HeaderMiddle}" Offset="0.56" />
            <GradientStop Color="{DynamicResource Layal.Color.HeaderEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Layal.CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Layal.Color.CardStart}" Offset="0" />
            <GradientStop Color="{DynamicResource Layal.Color.CardEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Layal.PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Layal.Color.ButtonStart}" Offset="0" />
            <GradientStop Color="{DynamicResource Layal.Color.ButtonEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Layal.Backdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Layal.Color.BackdropStart}" Offset="0" />
            <GradientStop Color="{DynamicResource Layal.Color.BackdropMiddle}" Offset="0.55" />
            <GradientStop Color="{DynamicResource Layal.Color.BackdropEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Layal.AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Layal.Color.AccentStart}" Offset="0" />
            <GradientStop Color="{DynamicResource Layal.Color.AccentEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Layal.MascotShellGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#E9F1FF" Offset="0.48" />
            <GradientStop Color="#EDE7FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Layal.MascotFaceGradient" StartPoint="0,0" EndPoint="0.2,1">
            <GradientStop Color="#243454" Offset="0" />
            <GradientStop Color="#111B31" Offset="0.72" />
            <GradientStop Color="#252446" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="Layal.CardShadow" Color="{DynamicResource Layal.Color.Shadow}" BlurRadius="24" ShadowDepth="5" Opacity="0.22" />
        <DropShadowEffect x:Key="Layal.GlassShadow" Color="{DynamicResource Layal.Color.Shadow}" BlurRadius="38" ShadowDepth="10" Opacity="0.24" />

        <!-- Shared high-visibility keyboard focus ring for controls without a custom focus state. -->
        <Style x:Key="Layal.KeyboardFocusVisual" TargetType="{x:Type Control}">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="1"
                                Background="Transparent"
                                BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                BorderThickness="3"
                                CornerRadius="4"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- Reusable, readable empty-state treatment. Specific lists opt in and supply their own count trigger. -->
        <Style x:Key="Layal.EmptyStateText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Layal.Muted}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="18" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="Background" Value="{DynamicResource Layal.GlassStrongFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Layal.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource Layal.HoverSurface}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource Layal.Cyan}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86" />
                                <Setter TargetName="ButtonChrome" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{DynamicResource Layal.Panel}" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Layal.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource Layal.Cyan}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Layal.Focus}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{DynamicResource Layal.Cyan}" />
                                <Setter TargetName="TextBoxChrome" Property="BorderThickness" Value="2" />
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="{DynamicResource Layal.InputFocus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{DynamicResource Layal.Panel}" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Layal.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource Layal.Cyan}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordChrome" Property="BorderBrush" Value="{DynamicResource Layal.Cyan}" />
                                <Setter TargetName="PasswordChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme-aware ComboBox; avoid the native light selection surface leaking into dark mode. -->
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="Background" Value="{DynamicResource Layal.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Layal.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBoxChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="1,0,4,0"
                                                  RecognizesAccessKey="True" />
                                <ToggleButton Grid.Column="1"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" CornerRadius="0,8,8,0">
                                                <Path Data="M 0,0 L 4,4 L 8,0 Z"
                                                      Width="8" Height="4" Stretch="Fill"
                                                      Fill="{DynamicResource Layal.Muted}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Layal.Panel}"
                                        BorderBrush="{DynamicResource Layal.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="3"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBoxChrome" Property="BorderBrush" Value="{DynamicResource Layal.Cyan}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBoxChrome" Property="BorderBrush" Value="{DynamicResource Layal.Cyan}" />
                                <Setter TargetName="ComboBoxChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBoxChrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Layal.ListHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Layal.ListSelected}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource Layal.Cyan}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Explicitly themed scrollbar template avoids the Windows default white thumb in dark mode. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource Layal.PanelAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Muted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Layal.Border}" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{x:Null}" Focusable="False" IsTabStop="False"
                                                  Background="Transparent" BorderThickness="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource Layal.ScrollThumb}"
                                           BorderBrush="{DynamicResource Layal.Border}"
                                           MinWidth="6" MinHeight="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbChrome"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="0"
                                                        CornerRadius="4"
                                                        Margin="1"
                                                        SnapsToDevicePixels="True" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Layal.Cyan}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Layal.Purple}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{x:Null}" Focusable="False" IsTabStop="False"
                                                  Background="Transparent" BorderThickness="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="10" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="10" />
                                <Setter Property="Height" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="Margin" Value="4,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="4,8" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Cyan}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Layal.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Layal.Panel}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11"
                                    Margin="0,9,0,0">
                                <ContentPresenter ContentSource="Content"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12,0,0,0"
                                    Padding="5,0"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Layal.Panel}" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Layal.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7" />
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Layal.ListHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Layal.ListSelected}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource Layal.Cyan}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass shell: a translucent sidebar (brand/footer overlays live in MainWindow, rows 88/156 are reserved for them)
             and a translucent content panel over the dusk backdrop. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource Layal.NavTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="244" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Layal.GlassFill}"
                                    BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
                                    CornerRadius="26" Margin="0,0,16,0" Effect="{DynamicResource Layal.GlassShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="88" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="156" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,4">
                                        <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"
                                                  VerticalAlignment="Top" HorizontalAlignment="Center" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource Layal.GlassStrongFill}"
                                    BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
                                    CornerRadius="26" Padding="8" Effect="{DynamicResource Layal.GlassShadow}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                  Margin="0" SnapsToDevicePixels="True" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Layal.NavTabItemStyle" TargetType="TabItem">
            <Setter Property="Width" Value="214" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavChrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NavGlyph" Grid.Column="0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           IsHitTestVisible="False" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource Layal.NavHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource Layal.AccentGradient}" />
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource Layal.NavSelectedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Layal.OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary round action (send). White-on-accent text is explicit because string content would otherwise pick up the implicit TextBlock colour. -->
        <Style x:Key="Layal.AccentButton" TargetType="Button">
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.OnAccent}" />
            <Setter Property="Background" Value="{DynamicResource Layal.AccentGradient}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AccentChrome" Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccentChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AccentChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="AccentChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded message field used by the chat composer. -->
        <Style x:Key="Layal.PillTextBox" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{DynamicResource Layal.GlassStrongFill}" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Layal.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource Layal.Cyan}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Layal.Focus}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="PillChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PillChrome" Property="BorderBrush" Value="{DynamicResource Layal.Cyan}" />
                                <Setter TargetName="PillChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PillChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimise / maximise / close in the custom title bar. -->
        <Style x:Key="Layal.CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Layal.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Layal.KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionChrome" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="{DynamicResource Layal.GlassStrongFill}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource Layal.Border}" />
            <Setter Property="Margin" Value="4,8" />
        </Style>
    </Application.Resources>
</Application>
