<Window x:Class="Layal.Views.FloatingMascotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Layal" Width="248" Height="175"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" MouseMove="Window_MouseMove">
    <Viewbox x:Name="MascotViewBox" Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="Root" Width="248" Height="175" Background="Transparent" ToolTip="Layal | Double-click to open">
            <!-- Soft pastel aura and orbital details keep the mascot readable over light or dark apps. -->
            <Ellipse x:Name="GlowHalo" Width="145" Height="107" Fill="#4077DFFF"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,21,0,0" Opacity="0.48">
                <Ellipse.Effect><BlurEffect Radius="15" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="121" Height="87" Fill="#40A7E7E9" HorizontalAlignment="Center"
                     VerticalAlignment="Top" Margin="0,28,0,0" Opacity="0.36">
                <Ellipse.Effect><BlurEffect Radius="18" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="151" Height="91" Fill="Transparent" Stroke="#88B8DDF1" StrokeThickness="1.3"
                     StrokeDashArray="2 5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,31,0,0"
                     IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-8" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="5" Height="5" Fill="#66A6E9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="23,43,0,0" />
            <Ellipse Width="4" Height="4" Fill="#A08BF0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,20,0" />
            <Path Data="M 0,5 L 5,0 L 10,5 L 5,10 Z" Fill="#B8A9F2" Opacity="0.9"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,26,0" />

            <!-- Native WPF 3D head/body/limb rig. A wide viewport gives articulated arms and feet room outside the head silhouette. The zero-opacity face canvas remains only for pointer coordinate compatibility. -->
            <Viewport3D x:Name="AvatarViewport" Width="248" Height="170"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"
                        IsHitTestVisible="False" ClipToBounds="True">
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0,0,2.6" LookDirection="0,0,-2.6"
                                       UpDirection="0,1,0" FieldOfView="46"/>
                </Viewport3D.Camera>
            </Viewport3D>

            <!-- Modern antenna: lilac stem, pearl mount, warm status light. -->
            <Ellipse Width="18" Height="7" Fill="#D8E4F8" Stroke="#BACCE9" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" />
            <Line x:Name="AntennaStem" Width="2" Height="18" X1="1" Y1="18" X2="1" Y2="1" Stroke="#8B79E6"
                  StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="88,5,0,0" />
            <Ellipse x:Name="AntennaDot" Width="12" Height="12" Fill="#FFD36E"
                     Stroke="#FFF8DE" StrokeThickness="1.2" HorizontalAlignment="Left"
                     VerticalAlignment="Top" Margin="83,1,0,0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Effect><DropShadowEffect Color="#D9A23B" BlurRadius="8" ShadowDepth="0" Opacity="0.48" /></Ellipse.Effect>
            </Ellipse>

            <!-- Transparent visual trim over the lit 3D shell and recessed 3D face display. -->
            <Border x:Name="Shell" Width="132" Height="96" CornerRadius="35" BorderThickness="0"
                    VerticalAlignment="Top" Margin="0,25,0,0"
                    Background="Transparent" HorizontalAlignment="Center">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7CDDE1" Offset="0" />
                        <GradientStop Color="#D4D7FA" Offset="0.48" />
                        <GradientStop Color="#9C8DEB" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#8798D8" BlurRadius="16" ShadowDepth="3" Opacity="0.27" />
                </Border.Effect>
                <Grid>
                    <Border Margin="9" CornerRadius="25" BorderThickness="1.4" BorderBrush="#AFC7EB"
                            Background="Transparent">
                        <Grid>
                            <Border Height="18" Margin="7,4,7,0" VerticalAlignment="Top" CornerRadius="18"
                                    Background="#16FFFFFF" IsHitTestVisible="False" />
                            <Canvas x:Name="FaceCanvas" ClipToBounds="True" Opacity="0">
                                <!-- Brows -->
                                <Path x:Name="LeftBrow" Data="M 26,18 Q 34,14 42,18" Stroke="#B7CCF7"
                                      StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path x:Name="RightBrow" Data="M 61,18 Q 69,14 77,18" Stroke="#B7CCF7"
                                      StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                <!-- Eyes have a subtle luminous edge and clear highlights. -->
                                <Ellipse Width="20" Height="25" Fill="#7C9DF7" Opacity="0.14" Canvas.Left="23.5" Canvas.Top="21.5" />
                                <Ellipse Width="20" Height="25" Fill="#7C9DF7" Opacity="0.14" Canvas.Left="60.5" Canvas.Top="21.5" />
                                <Ellipse x:Name="LeftEye" Width="17" Height="22" Fill="#F8FBFF" Canvas.Left="25" Canvas.Top="23" />
                                <Ellipse x:Name="RightEye" Width="17" Height="22" Fill="#F8FBFF" Canvas.Left="62" Canvas.Top="23" />
                                <Ellipse x:Name="LeftPupil" Width="7.5" Height="10" Fill="#18233E" Canvas.Left="29.8" Canvas.Top="29.5" />
                                <Ellipse x:Name="RightPupil" Width="7.5" Height="10" Fill="#18233E" Canvas.Left="66.8" Canvas.Top="29.5" />
                                <Ellipse x:Name="LeftEyeShine" Width="3.5" Height="4.2" Fill="#FFFFFF" Canvas.Left="30.8" Canvas.Top="27.2" IsHitTestVisible="False" />
                                <Ellipse x:Name="RightEyeShine" Width="3.5" Height="4.2" Fill="#FFFFFF" Canvas.Left="67.8" Canvas.Top="27.2" IsHitTestVisible="False" />
                                <Ellipse Width="2" Height="2" Fill="#FFFFFF" Opacity="0.9" Canvas.Left="35" Canvas.Top="34" />
                                <Ellipse Width="2" Height="2" Fill="#FFFFFF" Opacity="0.9" Canvas.Left="72" Canvas.Top="34" />

                                <!-- Soft cheeks -->
                                <Ellipse x:Name="CheekLeft" Width="11" Height="5.5" Fill="#FF91BC" Opacity="0.62" Canvas.Left="11" Canvas.Top="49" />
                                <Ellipse x:Name="CheekRight" Width="11" Height="5.5" Fill="#FF91BC" Opacity="0.62" Canvas.Left="82" Canvas.Top="49" />

                                <!-- Mouth geometry is updated by the state controller. -->
                                <Path x:Name="Mouth" Data="M 28,48 Q 51,72 78,48" Stroke="#F7FAFF"
                                      StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <!-- Reflective crown strip -->
                    <Border Height="3" Width="62" CornerRadius="1.5" Background="#FFFFFF" Opacity="0.78"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" />
                    <!-- Small status details on the shell -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Ellipse Width="3.5" Height="3.5" Fill="#7DD9DD" Margin="1" />
                        <Ellipse Width="3.5" Height="3.5" Fill="#A99AED" Margin="1" />
                        <Ellipse Width="3.5" Height="3.5" Fill="#F5C36C" Margin="1" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rounded side modules, upgraded from flat bars to layered sensor pods. -->
            <Border Width="17" Height="34" CornerRadius="8.5" Background="#DFF7F7"
                    BorderBrush="#7DD9DD" BorderThickness="1.3"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,54,0,0">
                <Grid>
                    <Border Width="5" Height="20" CornerRadius="2.5" Background="#2AB8C2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Width="17" Height="34" CornerRadius="8.5" Background="#EFEAFF"
                    BorderBrush="#B5A9F2" BorderThickness="1.3"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,54,8,0">
                <Grid>
                    <Border Width="5" Height="20" CornerRadius="2.5" Background="#8A78E7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Explicit status ring, connected to the agent's real state. -->
            <Border Width="19" Height="19" CornerRadius="9.5" Background="#FFFFFF" BorderBrush="#C9D6E9"
                    BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,19,0">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#32B985"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Task companions appear only while Layal is actively thinking or working. -->
            <Canvas x:Name="TaskPropsLayer" Width="248" Height="175"
                    IsHitTestVisible="False" ClipToBounds="False" Visibility="Collapsed">
                <!-- A floating task sheet with animated writing lines. -->
                <Canvas x:Name="PaperProp" Width="33" Height="45" Canvas.Left="7" Canvas.Top="94"
                        Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Border Width="31" Height="42" CornerRadius="4"
                            Background="#F7FFFFFF" BorderBrush="#9ADDE8" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Effect>
                            <DropShadowEffect Color="#5078B9D9" BlurRadius="8" ShadowDepth="2" Opacity="0.45"/>
                        </Border.Effect>
                        <Grid Margin="5,7,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#8D7FE8" CornerRadius="1" Margin="0,0,6,0"/>
                            <Border Grid.Row="1" Background="#79BFD4" CornerRadius="1" Margin="0,2,1,0"/>
                            <Border Grid.Row="2" Background="#BDDCEB" CornerRadius="1" Margin="0,2,5,0"/>
                            <Border Grid.Row="3" Background="#BDDCEB" CornerRadius="1" Margin="0,2,3,0"/>
                            <Border Grid.Row="4" Background="#F6C56D" CornerRadius="1" Width="9" Height="3"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </Grid>
                    </Border>
                </Canvas>

                <!-- A tiny pearl-and-lilac pencil, angled as though making notes. -->
                <Canvas x:Name="PencilProp" Width="9" Height="40" Canvas.Left="35" Canvas.Top="89"
                        Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Border Width="6" Height="29" Canvas.Left="1.5" Canvas.Top="1"
                            CornerRadius="2" Background="#DCD7FF" BorderBrush="#9587E8" BorderThickness="0.8"/>
                    <Border Width="2" Height="25" Canvas.Left="3.5" Canvas.Top="3"
                            CornerRadius="1" Background="#FFFFFF" Opacity="0.8"/>
                    <Path Data="M 1.5,29 L 7.5,29 L 4.5,38 Z" Fill="#F2C36D" Stroke="#B88F4B" StrokeThickness="0.5"/>
                    <Ellipse Width="4" Height="2" Fill="#FF94C8" Canvas.Left="2.5" Canvas.Top="0"/>
                </Canvas>

                <!-- A hovering translucent holo-computer with a tiny live-looking display. -->
                <Canvas x:Name="HoloComputerProp" Width="48" Height="43" Canvas.Left="198" Canvas.Top="126"
                        Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Border Width="46" Height="30" CornerRadius="6"
                            BorderBrush="#9CE9F0" BorderThickness="1.2"
                            Background="#D7233A60" Canvas.Left="1" Canvas.Top="0">
                        <Border.Effect>
                            <DropShadowEffect Color="#46D9F3" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
                        </Border.Effect>
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="3" Height="3" Fill="#FF91C8" Margin="0,0,3,0"/>
                                <Ellipse Width="3" Height="3" Fill="#FFD477" Margin="0,0,3,0"/>
                                <TextBlock Text="AI" FontSize="6.5" FontWeight="Bold" Foreground="#E9FCFF"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,3,0">
                                    <Border Width="7" Height="2" Background="#83E7EB" Margin="0,0,0,2"/>
                                    <Border Width="5" Height="2" Background="#B8A8FA" Margin="0,0,0,2"/>
                                    <Border Width="8" Height="2" Background="#83E7EB"/>
                                </StackPanel>
                                <Polyline Grid.Column="1" Points="0,12 5,7 9,9 14,1"
                                          Stroke="#95F2DB" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Path Data="M 4,32 L 44,32 L 37,38 L 11,38 Z"
                          Fill="#A5EAF2" Stroke="#70CCD9" StrokeThickness="0.8"/>
                    <Border Width="12" Height="2" CornerRadius="1" Background="#F4FDFF"
                            Canvas.Left="18" Canvas.Top="34" Opacity="0.9"/>
                    <Ellipse Width="4" Height="4" Fill="#9AEAF2" Canvas.Left="40" Canvas.Top="39" Opacity="0.9"/>
                </Canvas>
            </Canvas>

            <!-- Procedural cinematic particles: hearts, flowers, glints and task-stage glyphs. -->
            <Canvas x:Name="CinematicEffectsLayer" Width="248" Height="175"
                    IsHitTestVisible="False" ClipToBounds="False" Visibility="Collapsed" />

            <!-- Short-lived, animated reaction bubble; it never intercepts pointer input. -->
            <Canvas x:Name="ReactionLayer" IsHitTestVisible="False" ClipToBounds="False">
                <Border x:Name="ReactionBubble" Width="48" Height="45" Canvas.Left="185" Canvas.Top="29"
                        Visibility="Collapsed" Opacity="0" CornerRadius="16" Background="#F5FFFFFF"
                        BorderBrush="#B8CBE8" BorderThickness="1" Padding="2"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Effect>
                        <DropShadowEffect Color="#6A7FAD" BlurRadius="9" ShadowDepth="2" Opacity="0.22"/>
                    </Border.Effect>
                    <emoji:TextBlock x:Name="ReactionEmojiText" Text="✨" FontFamily="Segoe UI Emoji"
                               FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Canvas>
        </Grid>
    </Viewbox>
</Window>
