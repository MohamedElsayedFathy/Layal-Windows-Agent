<Window x:Class="Layal.Views.VisionCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الرؤية بالكاميرا" Width="1000" Height="760" MinWidth="760" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        AutomationProperties.Name="نافذة الرؤية بالكاميرا">
    <Border Margin="12" Padding="14" CornerRadius="18"
            Background="{DynamicResource Layal.GlassFill}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}"
            BorderThickness="1" Effect="{DynamicResource Layal.CardShadow}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="VisionPrivacyText" TextWrapping="Wrap" Margin="2,0,2,12"
                   Foreground="{DynamicResource Layal.Muted}"
                   AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                <Button x:Name="ScanNetworkCamerasButton" Content="فحص كاميرات الشبكة المحلية"
                        Click="ScanNetworkCamerasButton_Click" MinWidth="200" Margin="0,0,8,4"
                        AutomationProperties.Name="فحص كاميرات ONVIF على الشبكة المحلية"
                        AutomationProperties.HelpText="يرسل طلب اكتشاف ONVIF على الشبكة المحلية فقط؛ لا يحاول تخمين كلمات المرور أو فتح بث الكاميرا."/>
                <ComboBox x:Name="DiscoveredCamerasSelector" Width="360" MinWidth="220" Margin="0,0,8,4"
                          DisplayMemberPath="DisplayName" VerticalContentAlignment="Center"
                          AutomationProperties.Name="الكاميرات المكتشفة على الشبكة المحلية"
                          AutomationProperties.HelpText="اختر كاميرا اكتشافها بروتوكول ONVIF؛ يحتاج فتح البث إلى بيانات دخول صحيحة."/>
                <Button x:Name="UseLocalCameraButton" Content="استخدام كاميرا الكمبيوتر"
                        Click="UseLocalCameraButton_Click" MinWidth="180" Margin="0,0,0,4"/>
            </WrapPanel>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="عنوان RTSP (اختياري)" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <TextBox x:Name="ManualRtspAddressInput" Width="250" MinWidth="180" Margin="0,0,12,4"
                         ToolTip="rtsp://192.168.1.20:554/path — من دون اسم مستخدم أو كلمة مرور"
                         AutomationProperties.Name="عنوان RTSP المحلي لكاميرا مصرح بها"
                         AutomationProperties.HelpText="استخدم عنوانًا على شبكة خاصة محلية فقط؛ أدخل بيانات الدخول في الحقول المنفصلة."/>
                <TextBlock Text="اسم المستخدم" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <TextBox x:Name="CameraUsernameInput" Width="150" MinWidth="100" Margin="0,0,12,4"
                         AutomationProperties.Name="اسم مستخدم كاميرا الشبكة"/>
                <TextBlock Text="كلمة المرور" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <PasswordBox x:Name="CameraPasswordInput" Width="160" MinWidth="100" Margin="0,0,12,4"
                             AutomationProperties.Name="كلمة مرور كاميرا الشبكة"
                             AutomationProperties.HelpText="تُستخدم مؤقتًا للاتصال بالكاميرا المختارة ولا تُحفظ في الإعدادات."/>
                <Button x:Name="ConnectNetworkCameraButton" Content="الاتصال ببث الكاميرا المختارة"
                        Click="ConnectNetworkCameraButton_Click" MinWidth="220" Margin="0,0,0,4"
                        AutomationProperties.Name="الاتصال بكاميرا الشبكة المختارة"
                        AutomationProperties.HelpText="يتطلب بيانات دخول صالحة وصلاحية ONVIF؛ لا توجد محاولة لتجاوز المصادقة."/>
            </WrapPanel>
            <TextBlock x:Name="NetworkCameraHelpText" TextWrapping="Wrap" Margin="0,5,0,0"
                       Foreground="{DynamicResource Layal.Muted}"/>
        </StackPanel>
        <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Layal.Border}"
                Background="{DynamicResource Layal.Panel}" Padding="8">
            <Image x:Name="CameraPreview" Stretch="Uniform" AutomationProperties.Name="المعاينة المباشرة للكاميرا"/>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="ContinuousObservationCheckBox" Content="التحليل التلقائي غير متاح حاليًا"
                          IsEnabled="False" VerticalAlignment="Center" Margin="8,0"
                          AutomationProperties.Name="التحليل البصري التلقائي غير متاح"
                          AutomationProperties.HelpText="ميزة الرؤية المستقلة لم تُنفّذ بعد؛ لا يتم التقاط إطارات للتحليل أو إرسالها إلى أي نموذج."/>
                <CheckBox x:Name="SpeakCameraObservationsCheckBox" Content="النطق التلقائي للملاحظات غير متاح"
                          IsEnabled="False" VerticalAlignment="Center" Margin="8,0"
                          AutomationProperties.Name="النطق التلقائي للملاحظات البصرية غير متاح"
                          AutomationProperties.HelpText="لا توجد ملاحظات بصرية مولّدة لأن محرك الرؤية المستقل غير متاح."/>
                <Button x:Name="ScanSurroundingsButton" Content="مسح المكان غير متاح حاليًا"
                        IsEnabled="False" MinWidth="180" Margin="4,0"
                        AutomationProperties.Name="مسح المكان غير متاح"
                        AutomationProperties.HelpText="لا يتوفر تحليل للمشهد أو مسح ثلاثي الأبعاد في النواة الحالية."/>
                <Button x:Name="AnalyzeCurrentFrameButton" Content="تحليل اللقطة غير متاح حاليًا"
                        IsEnabled="False" MinWidth="150" Margin="4,0"/>
                <Button x:Name="CloseCameraButton" Content="إيقاف الكاميرا" Click="CloseCameraButton_Click" MinWidth="120" Margin="4,0"/>
            </WrapPanel>
            <TextBlock x:Name="CameraStatusText" Text="جارٍ تهيئة الكاميرا..." TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="{DynamicResource Layal.Muted}"
                       AutomationProperties.Name="حالة الكاميرا" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid>
    </Border>
</Window>
