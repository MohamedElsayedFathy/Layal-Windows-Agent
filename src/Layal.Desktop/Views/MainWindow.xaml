        <!-- Persistent Soft Aurora navigation rail; expanded on first launch. -->
        <Grid x:Name="BottomDockHost" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Stretch"
              Margin="14,10,0,12" Panel.ZIndex="100" KeyboardNavigation.TabNavigation="Local">
            <Border x:Name="BottomDockShell" Background="{DynamicResource Layal.GlassStrongFill}"
                    BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="24" Padding="10" Effect="{DynamicResource Layal.CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="3,3,3,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="13"
                                Background="{DynamicResource Layal.AccentGradient}" Margin="0,0,8,0">
                            <TextBlock Text="L" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource Layal.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="DockBrandCopy" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="LAYAL" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource Layal.Text}"/>
