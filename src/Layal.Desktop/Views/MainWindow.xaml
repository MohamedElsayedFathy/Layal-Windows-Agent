                                      AutomationProperties.HelpText="أظهر الملاحظات المؤرشفة لعرضها واستعادتها."/>
                            <TextBlock x:Name="MemoryCategoryFilterLabel" Text="تصفية التصنيف" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <ComboBox x:Name="MemoryCategoryFilter" MinWidth="150" MinHeight="30"
                                      SelectionChanged="MemoryCategoryFilter_SelectionChanged"
                                      AutomationProperties.Name="تصفية الذاكرة حسب التصنيف / Filter memory by category"/>
                            <Button x:Name="ClearMemoryFiltersButton" Content="مسح عوامل التصفية" Click="ClearMemoryFiltersButton_Click"/>
                            <TextBlock x:Name="MemoryCountText" Margin="10,6,4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Layal.Muted}"
                                       AutomationProperties.Name="عدد ملاحظات الذاكرة / Memory note count"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </WrapPanel>
                        <TextBlock x:Name="MemoryFilterNotice" Text="" Margin="4,4,4,0"
                                   Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="MemoryList" Grid.Column="0" ItemsSource="{Binding MemoryNotes}" AutomationProperties.Name="ملاحظات الذاكرة" AutomationProperties.HelpText="اختر ملاحظة لعرضها أو تعديلها." SelectionChanged="MemoryList_SelectionChanged" Background="{DynamicResource Layal.GlassFill}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Layal.CardGradient}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="15" Padding="13" Margin="3">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FlowDirection="{Binding Title, Converter={StaticResource Layal.TextDirectionConverter}}"
                                                   TextAlignment="{Binding Title, Converter={StaticResource Layal.TextDirectionConverter}}"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Layal.Text}" />
                                        <WrapPanel Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                       Foreground="{DynamicResource Layal.Muted}"/>
                                            <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource Layal.Muted}"/>
                                            <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}" FontSize="11"
                                                       Foreground="{DynamicResource Layal.Muted}"/>
                                            <TextBlock Text="  ·  مؤرشفة / Archived" FontSize="11"
                                                       Foreground="{DynamicResource Layal.Warning}" Visibility="Collapsed">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </WrapPanel>
                                    </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="MemoryEmptyStateText" Grid.Column="0"
                                   Text="No saved notes. Create a note to get started."
                                   AutomationProperties.Name="Memory empty state">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Layal.EmptyStateText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MemoryNotes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Grid.Column="1" Background="{DynamicResource Layal.GlassFill}"
                                BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="18" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="MemoryCategoryLabel" Text="التصنيف" Margin="0,0,0,4"/>
                                <TextBox x:Name="MemoryCategoryInput" MinHeight="32" MaxLength="40" Text="General"
                                         AutomationProperties.Name="تصنيف الملاحظة / Memory note category"
                                         AutomationProperties.LabeledBy="{Binding ElementName=MemoryCategoryLabel}"
                                         ToolTip="General, Work, Project..."/>
                                <TextBlock x:Name="MemoryTitleLabel" Text="العنوان" Margin="0,10,0,4"/>
                                <TextBox x:Name="MemoryTitleInput" MinHeight="32" MaxLength="120" AutomationProperties.Name="عنوان الملاحظة / Memory note title" AutomationProperties.LabeledBy="{Binding ElementName=MemoryTitleLabel}"/>
                                <TextBlock x:Name="MemoryContentLabel" Text="المحتوى" Margin="0,10,0,4"/>
                                <TextBox x:Name="MemoryContentInput" MinHeight="160" MaxLength="12000" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="محتوى الملاحظة / Memory note content" AutomationProperties.LabeledBy="{Binding ElementName=MemoryContentLabel}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="SaveMemoryButton" Content="حفظ الملاحظة" Click="SaveMemoryButton_Click"/>
                                    <Button x:Name="ArchiveMemoryButton" Content="أرشفة" Click="ArchiveMemoryButton_Click" IsEnabled="False"/>
                                    <Button x:Name="DeleteMemoryButton" Content="حذف" Click="DeleteMemoryButton_Click" IsEnabled="False"/>
                                </WrapPanel>
                                <TextBlock x:Name="MemoryResult" Text="" Foreground="{DynamicResource Layal.Success}" TextWrapping="Wrap" Margin="4,10,4,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </ScrollViewer>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="MemoryPrivacyNote" Grid.Row="3"
                               Text="لا تحفظ مفاتيح API أو كلمات المرور. تصدير JSON غير مشفر؛ الاستيراد يدمج الملاحظات الجديدة ولا يستبدل الموجود. مشاركة أي نتيجة مع AI تتطلب عرض النص الكامل وموافقتك."
                               Foreground="{DynamicResource Layal.Warning}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                </Grid>
</Border>
            </TabItem>

            <TabItem x:Name="ApiIntegrationsTab" Header="تكاملات API" Tag="&#xE71B;">
                <Border Style="{StaticResource Layal.PageCanvas}" Margin="0,2,0,2">
<Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Layal.PageHero}" Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="CONNECTED SERVICES  /  الخدمات المتصلة" Style="{StaticResource Layal.SectionEyebrow}"/>
                            <TextBlock x:Name="ApiIntegrationsHeading" Text="ربط التطبيقات عبر API" FontWeight="SemiBold" Style="{StaticResource Layal.PageHeading}"/>
                            <TextBlock x:Name="ApiIntegrationsDescription" Text="أضف عددًا كبيرًا من اتصالات REST/JSON وابحث بينها. يمكن تعيين اتصال متوافق مع OpenAI كـ API ليال السحابي الاختياري؛ هذا إعداد لمزود تستخدمه ليال وليس خادم API عامًا مستضافًا منها." TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource Layal.PageDescription}"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.82*"/><ColumnDefinition Width="1.18*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Layal.GlassFill}"
                                BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="ApiConnectionsListLabel" Text="التطبيقات المتصلة" FontWeight="SemiBold" Margin="4,0,4,5"/>
                            <TextBox x:Name="ApiConnectionSearchInput" MinHeight="32" Margin="0,0,0,6"
                                     ToolTip="ابحث بالاسم أو عنوان API أو التفاصيل"
                                     AutomationProperties.Name="البحث في اتصالات API / Search API connections"
                                     AutomationProperties.HelpText="يبحث في اسم الاتصال وعنوان API والتفاصيل دون البحث في مفاتيح المصادقة."
                                     TextChanged="ApiConnectionSearchInput_TextChanged"/>
                            <ListBox x:Name="ApiConnectionList" ItemsSource="{Binding ApiConnections}" SelectionChanged="ApiConnectionList_SelectionChanged"
                                     Background="{DynamicResource Layal.GlassFill}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}" Padding="8" MinHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Layal.CardGradient}" CornerRadius="10" Padding="10" Margin="2" BorderBrush="{StaticResource Layal.Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding ImagePath}" Width="44" Height="44" Stretch="UniformToFill" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Layal.Cyan}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding BaseUrl}" Foreground="{DynamicResource Layal.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding ModelId}" Foreground="{DynamicResource Layal.Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="API ليال الحالي / Current Layal API" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Layal.Success}" Margin="0,3,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLayalProvider}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="NewApiConnectionButton" Content="إضافة اتصال جديد" Click="NewApiConnectionButton_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ApiConnectionsPrivacyNote" Text="لا تشارك مفتاح API داخل المحادثة. أدخله هنا؛ سيُحفظ مشفرًا على حساب Windows الحالي." Foreground="{DynamicResource Layal.Warning}" TextWrapping="Wrap" Margin="4,8,4,0"/>
                        </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource Layal.GlassFill}"
                                BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="18" Margin="10,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="ApiConnectionNameLabel" Text="اسم التطبيق / الاتصال" Margin="4,2,4,0"/>
                                <TextBox x:Name="ApiConnectionNameInput" MinHeight="32" ToolTip="Notion, GitHub, CRM..." />
                                <TextBlock x:Name="ApiConnectionBaseUrlLabel" Text="عنوان API الأساسي (إجباري)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiConnectionBaseUrlInput" FlowDirection="LeftToRight" MinHeight="32" ToolTip="https://api.example.com/v1"/>
                                <TextBlock x:Name="ApiConnectionModelIdLabel" Text="معرّف النموذج (اختياري، مطلوب عند استخدامه كـ API ليال)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiConnectionModelIdInput" FlowDirection="LeftToRight" MinHeight="32" ToolTip="gpt-4.1-mini or provider model ID"/>
                                <TextBlock x:Name="ApiConnectionImageLabel" Text="صورة التطبيق (اختياري)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiConnectionImagePathInput" IsReadOnly="True" MinHeight="32" ToolTip="الصورة تُنسخ إلى مجلد بيانات ليال المحلي."/>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button x:Name="ChooseApiImageButton" Content="اختيار صورة..." Click="ChooseApiImageButton_Click"/>
                                    <Button x:Name="ClearApiImageButton" Content="مسح الصورة" Click="ClearApiImageButton_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="ApiAuthTypeLabel" Text="طريقة المصادقة" Margin="4,8,4,0"/>
                                <ComboBox x:Name="ApiAuthTypeComboBox" MinHeight="32" SelectedIndex="1">
                                    <ComboBoxItem Content="بدون مصادقة / None" Tag="None"/>
                                    <ComboBoxItem Content="Bearer token" Tag="Bearer"/>
                                    <ComboBoxItem Content="Custom header (API key)" Tag="CustomHeader"/>
                                </ComboBox>
                                <TextBlock x:Name="ApiAuthHeaderNameLabel" Text="اسم ترويسة المصادقة (Custom header)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiAuthHeaderNameInput" FlowDirection="LeftToRight" Text="X-API-Key" MinHeight="32"/>
                                <TextBlock x:Name="ApiAuthSecretLabel" Text="Token / API key / header value" Margin="4,8,4,0"/>
                                <PasswordBox x:Name="ApiAuthSecretInput" FlowDirection="LeftToRight" MinHeight="32"/>
                                <TextBlock x:Name="ApiAdditionalHeadersLabel" Text="ترويسات HTTP إضافية غير سرية (JSON)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiAdditionalHeadersInput" FlowDirection="LeftToRight" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         ToolTip="Example additional header: Notion-Version"/>
                                <TextBlock x:Name="ApiTestPathLabel" Text="مسار اختبار الاتصال (GET)، مثل health أو users/me" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiTestPathInput" FlowDirection="LeftToRight" MinHeight="32"/>
                                <TextBlock x:Name="ApiInstructionsLabel" Text="التفاصيل وملاحظات API (اختياري، بدون أسرار)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiInstructionsInput" MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         ToolTip="اكتب المسارات وطريقة الاستخدام التي تريد أن تعرفها ليال."/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="SaveApiConnectionButton" Content="حفظ الاتصال" Click="SaveApiConnectionButton_Click"/>
                                    <Button x:Name="UseAsLayalApiButton" Content="استخدام هذا كـ API ليال" Click="UseAsLayalApiButton_Click"/>
                                    <Button x:Name="TestApiConnectionButton" Content="اختبار API" Click="TestApiConnectionButton_Click" Background="{StaticResource Layal.PrimaryButtonGradient}"/>
                                    <Button x:Name="DeleteApiConnectionButton" Content="حذف الاتصال المحدد" Click="DeleteApiConnectionButton_Click" Background="{DynamicResource Layal.DangerSurface}" BorderBrush="{DynamicResource Layal.DangerBorder}"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ApiConnectionsStatus" Grid.Row="2" Text="" Foreground="{DynamicResource Layal.Success}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                </Grid>
</Border>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="الإعدادات" Tag="&#xE713;">
                <Border Style="{StaticResource Layal.PageCanvas}" Margin="0,2,0,2">
<ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource Layal.PageHero}">
                            <StackPanel>
                                <TextBlock Text="PREFERENCES  /  التفضيلات" Style="{StaticResource Layal.SectionEyebrow}"/>
                                <TextBlock x:Name="SettingsHeading" Text="الإعدادات والاتصال" FontWeight="SemiBold" Margin="0,0,0,12" Style="{StaticResource Layal.PageHeading}"/>
                                <TextBlock Text="خصص تجربة Layal، وأدر مزودي الذكاء الاصطناعي والصوت والخصوصية واللغة من مكان واحد." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
