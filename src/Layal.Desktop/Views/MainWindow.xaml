                                    AutomationProperties.Name="إرفاق صورة أو لقطة شاشة"
                                    AutomationProperties.HelpText="اختر ملف صورة؛ لا يُرسل إلى مزود الذكاء الاصطناعي إلا عند الضغط على إرسال."/>
                            <Button x:Name="ClearVisionImageButton" Content="إزالة الصورة" Click="ClearVisionImageButton_Click"
                                    Visibility="Collapsed" MinWidth="90" ToolTip="إزالة الصورة المرفقة قبل الإرسال."/>
                            <Button x:Name="ReadClipboardButton" Content="قراءة الحافظة" Click="ReadClipboardButton_Click"
                                    MinWidth="105" ToolTip="اقرأ النص من الحافظة بطلب صريح، وراجعه محليًا قبل إرفاقه."
                                    AutomationProperties.Name="قراءة نص الحافظة لمراجعته"
                                    AutomationProperties.HelpText="قراءة نص الحافظة لا تغيّر محتواها ولا ترسله. الإرسال لا يحدث إلا بعد الضغط على إرسال."/>
                            <Button x:Name="ChooseDocumentButton" Content="إرفاق ملف نصي/PDF/Office" Click="ChooseDocumentButton_Click"
                                    MinWidth="160" ToolTip="يُستخرج النص محليًا وتراجعه قبل الإرفاق؛ لا يُرسل إلا عند الضغط على إرسال."
                                    AutomationProperties.Name="اختيار ملف لمراجعته وإرفاقه"
                                    AutomationProperties.HelpText="يدعم TXT وMarkdown وCSV وJSON وXML وHTML وPDF النصي وDOCX وXLSX، بحد أقصى 20 ميجابايت."/>
                            <Button x:Name="ClearDocumentButton" Content="إزالة الملف" Click="ClearDocumentButton_Click"
                                    Visibility="Collapsed" MinWidth="90" ToolTip="إزالة محتوى الملف المرفق قبل الإرسال."/>
                            <Button x:Name="CameraVisionButton" Content="فتح الكاميرا" Click="CameraVisionButton_Click"
                                    ToolTip="معاينة الكاميرا محليًا وتحليل لقطة عند الطلب." MinWidth="110"
                                    AutomationProperties.Name="فتح كاميرا الرؤية"
                                    AutomationProperties.HelpText="يفتح معاينة الكاميرا بعد موافقتك. لا تُرسل اللقطات إلا عند التحليل اليدوي أو تفعيل التحليل التلقائي."/>
                            <Image x:Name="VisionAttachmentPreview" Width="54" Height="40" Margin="7,0,2,0"
                                   Stretch="Uniform" Visibility="Collapsed"
                                   AutomationProperties.Name="معاينة الصورة المرفقة"/>
                            <TextBlock x:Name="VisionAttachmentStatus" Text="لا توجد صورة مرفقة" VerticalAlignment="Center"
                                       Margin="8,0,4,0" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap"
                                       AutomationProperties.Name="حالة الصورة المرفقة" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="DocumentAttachmentStatus" Text="لا يوجد ملف مرفق" VerticalAlignment="Center"
                                       MaxWidth="280" Margin="8,0,4,0" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap"
                                       AutomationProperties.Name="حالة الملف النصي المرفق" AutomationProperties.LiveSetting="Polite"/>
                        </WrapPanel>
                        <TextBlock x:Name="ChatNotice" Text="تحتاج إلى عنوان API ومفتاح صحيح من الإعدادات لإرسال رسائل حقيقية." FontSize="11" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0"/>
                        <TextBlock x:Name="ChatActivityStatus" Text="" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap"
                                   AutomationProperties.Name="حالة المحادثة" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="ChatCopyStatus" Text="" Foreground="{DynamicResource Layal.Success}" TextWrapping="Wrap"
                                   AutomationProperties.Name="حالة النسخ" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Border x:Name="ChatComposerShell" Grid.Row="4" Margin="3,0,3,0" Padding="5,4" CornerRadius="22"
                            Background="{DynamicResource Layal.GlassStrongFill}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}"
                            BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Style="{StaticResource Layal.PillTextBox}" Grid.Column="0" FlowDirection="RightToLeft" MinHeight="46" VerticalContentAlignment="Center" KeyDown="ChatInput_KeyDown" ToolTip="اكتب رسالة ثم اضغط Enter" AutomationProperties.Name="رسالة المحادثة / Chat message" AutomationProperties.HelpText="اكتب رسالة ثم اضغط Enter لإرسالها / Type a message and press Enter to send. Ctrl+2 ينقلك إلى هذا الحقل."/>
                        <Button x:Name="SpeechToTextButton" Grid.Column="1" Content="تسجيل صوت" Click="SpeechToTextButton_Click" MinWidth="112" ToolTip="تسجيل يدوي فقط؛ لا يُرسل الصوت إلا بعد تأكيدك." AutomationProperties.Name="تسجيل صوت لتحويله إلى نص" AutomationProperties.HelpText="اضغط لبدء التسجيل، واضغط ثانية لإيقافه. لن يُرسل الصوت إلى المزود إلا بعد تأكيد منفصل، وسيظهر النص للمراجعة قبل الإرسال."/>
                        <Button x:Name="VoiceConversationButton" Grid.Column="2" Content="بدء المحادثة الصوتية" Click="VoiceConversationButton_Click" MinWidth="148"
                                ToolTip="محادثة صوتية مباشرة: يستخدم الميكروفون ويبث الصوت إلى موفر Realtime حتى تضغط إيقاف."
                                AutomationProperties.Name="بدء المحادثة الصوتية" AutomationProperties.HelpText="يُبث صوت الميكروفون مباشرة إلى موفر Realtime أثناء الجلسة. اضغط مرة أخرى لإيقاف الميكروفون والمحادثة."/>
                        <Button x:Name="SendButton" Style="{StaticResource Layal.AccentButton}" Grid.Column="3" Content="إرسال" Click="SendButton_Click" MinWidth="84"/>
                        <Button x:Name="CancelResponseButton" Grid.Column="4" Content="إيقاف" Click="CancelResponseButton_Click" MinWidth="72" IsEnabled="False"/>
                    </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="TasksTab" Header="المهام">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="TasksHeading" Text="مركز المهام" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TasksDescription" Grid.Row="1" Text="اكتب مهمة. ستطلب ليال موافقتك قبل الأدوات التي تغيّر الملفات أو تفتح تطبيقات أو تشارك بيانات." TextWrapping="Wrap" Foreground="{DynamicResource Layal.Muted}" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="TaskInput" MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="اكتب المهمة بالعربية أو الإنجليزية" AutomationProperties.Name="وصف المهمة / Task description" AutomationProperties.HelpText="صف المهمة التي تريد تنفيذها / Describe the task you want to perform. استخدم Tab للوصول إلى زر تنفيذ المهمة."/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="RunAgentTaskButton" Content="تنفيذ المهمة" Click="RunAgentTaskButton_Click" Background="{DynamicResource Layal.PrimaryButtonGradient}"/>
                            <Button x:Name="CancelAgentTaskButton" Content="إيقاف المهمة" Click="CancelAgentTaskButton_Click" IsEnabled="False" Background="{DynamicResource Layal.DangerSurface}" BorderBrush="{DynamicResource Layal.DangerBorder}"/>
                            <Button x:Name="TaskOpenNotepadButton" Content="فتح المفكرة (اختبار)" Click="OpenNotepadButton_Click"/>
                            <Button x:Name="ManageRemindersButton" Content="التذكيرات" Click="ManageRemindersButton_Click"
                                    MinWidth="105" ToolTip="إدارة تذكيرات محلية مشفرة؛ تظهر الإشعارات أثناء تشغيل ليال."
                                    AutomationProperties.Name="إدارة التذكيرات المحلية"
                                    AutomationProperties.HelpText="أنشئ تذكيرًا لمرة واحدة أو يوميًا أو أسبوعيًا. تُحفظ التذكيرات مشفرة محليًا ولا تُرسل لمزود AI."/>
                            <Button x:Name="ManageRoutinesButton" Content="الروتينات" Click="ManageRoutinesButton_Click"
                                    MinWidth="105" ToolTip="احفظ أهدافًا نصية متكررة. اختيار الروتين يملأ المسودة فقط ولا يشغله تلقائيًا."
                                    AutomationProperties.Name="إدارة الروتينات المحفوظة"
                                    AutomationProperties.HelpText="قوالب نصية مشفرة محليًا وليست سكربتات؛ راجع الهدف واضغط تنفيذ المهمة بنفسك."/>
                        </WrapPanel>
                        <TextBlock x:Name="TaskSkillHint" Text="يمكنك تحديد حتى 3 مهارات في تبويب المهارات لاستخدامها كمراجع غير موثوقة." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="4,6,4,0"/>
                        <TextBlock x:Name="TaskSafeToolTitle" Text="أدوات Windows المحدودة" FontWeight="SemiBold" Margin="4,5,4,0"/>
                        <TextBlock x:Name="TaskSafeToolDescription" Text="الأدوات المتاحة محددة؛ لا يوجد وصول عام غير مقيد إلى سطر الأوامر أو الملفات." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="4,3,4,0"/>
                        <WrapPanel Margin="4,8,4,0" VerticalAlignment="Center">
                            <CheckBox x:Name="ProactiveCheckInEnabledCheckBox" Content="تذكيرات متابعة استباقية" Click="ProactiveCheckInEnabledCheckBox_Click"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      AutomationProperties.Name="تفعيل تذكيرات المتابعة المجدولة"
                                      AutomationProperties.HelpText="إشعارات محلية في موعد تختاره. لا تراقب الشاشة أو التطبيقات ولا تستدعي نموذج AI في الخلفية."/>
                            <ComboBox x:Name="ProactiveCheckInIntervalSelector" Width="130" MinHeight="28"
                                      SelectionChanged="ProactiveCheckInIntervalSelector_SelectionChanged"
                                      AutomationProperties.Name="الفاصل الزمني لتذكير المتابعة"
                                      AutomationProperties.HelpText="اختر 15 أو 30 أو 60 أو 120 دقيقة بين إشعارات المتابعة.">
                                <ComboBoxItem Content="15 دقيقة" Tag="15"/>
                                <ComboBoxItem Content="30 دقيقة" Tag="30"/>
                                <ComboBoxItem Content="60 دقيقة" Tag="60"/>
                                <ComboBoxItem Content="120 دقيقة" Tag="120"/>
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock x:Name="ProactiveCheckInPrivacyNote" Text="الوضع الاستباقي هنا يرسل تذكيرًا محليًا فقط، ولا يفحص النوافذ أو الشاشة أو الملفات."
                                   Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="4,4,4,0"
                                   AutomationProperties.Name="حدود خصوصية تذكيرات المتابعة"/>
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="سجل تنفيذ المهمة" Foreground="{DynamicResource Layal.Text}" BorderBrush="{DynamicResource Layal.Border}" Background="{DynamicResource Layal.Panel}" Padding="8" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Button x:Name="CopyTaskLogButton" Grid.Row="0" Content="نسخ سجل التنفيذ" Click="CopyTaskLogButton_Click" HorizontalAlignment="Right" Margin="2,0,2,6"/>
                                <ListBox x:Name="TaskEventsList" Grid.Row="1" ItemsSource="{Binding TaskEvents}" AutomationProperties.Name="سجل أحداث المهمة" AutomationProperties.LiveSetting="Polite" Background="{DynamicResource Layal.Panel}" BorderBrush="{DynamicResource Layal.Border}" Foreground="{DynamicResource Layal.Text}" Padding="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FlowDirection="{Binding Converter={StaticResource Layal.TextDirectionConverter}}"
                                                       TextAlignment="{Binding Converter={StaticResource Layal.TextDirectionConverter}}"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource Layal.Text}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="TaskEventsEmptyStateText" Grid.Row="1"
                                           Text="No task activity yet. Start a task to see its events here."
                                           AutomationProperties.Name="Task activity empty state">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Layal.EmptyStateText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TaskEvents.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" x:Name="RecentTasksGroup" Header="المهام السابقة" Foreground="{DynamicResource Layal.Text}" BorderBrush="{DynamicResource Layal.Border}" Background="{DynamicResource Layal.Panel}" Padding="8" Margin="6,0,0,0">
                            <Grid>
                                <ListBox x:Name="RecentTasksList" ItemsSource="{Binding RecentTasks}" AutomationProperties.Name="المهام السابقة" AutomationProperties.HelpText="اختر مهمة سابقة لعرض تفاصيلها." SelectionChanged="RecentTasksList_SelectionChanged" Background="{DynamicResource Layal.Panel}" BorderBrush="{DynamicResource Layal.Border}" Padding="4">
                                    <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Layal.CardGradient}" CornerRadius="10" Padding="10" Margin="2" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Goal}" FlowDirection="{Binding Goal, Converter={StaticResource Layal.TextDirectionConverter}}" TextAlignment="{Binding Goal, Converter={StaticResource Layal.TextDirectionConverter}}" FontWeight="SemiBold" Foreground="{DynamicResource Layal.Text}" TextWrapping="Wrap"/><TextBlock Text="{Binding DisplayStatus}" FlowDirection="{Binding DisplayStatus, Converter={StaticResource Layal.TextDirectionConverter}}" TextAlignment="{Binding DisplayStatus, Converter={StaticResource Layal.TextDirectionConverter}}" Foreground="{DynamicResource Layal.Cyan}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding DisplayUpdatedAt}" FlowDirection="{Binding DisplayUpdatedAt, Converter={StaticResource Layal.TextDirectionConverter}}" TextAlignment="{Binding DisplayUpdatedAt, Converter={StaticResource Layal.TextDirectionConverter}}" Foreground="{DynamicResource Layal.Muted}" FontSize="10"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="RecentTasksEmptyStateText"
                                           Text="No previous tasks yet."
                                           AutomationProperties.Name="Recent tasks empty state">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Layal.EmptyStateText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentTasks.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </GroupBox>
                    </Grid>
                    <StackPanel Grid.Row="4" Margin="4,10,4,0">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button x:Name="CopyTaskResultButton" Content="نسخ النتيجة" Click="CopyTaskResultButton_Click"/>
                        </WrapPanel>
                        <TextBox x:Name="TaskResult" Text="لم تُنفذ أي عملية بعد." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 MinHeight="68" MaxHeight="170" Padding="9" Margin="0,4,0,0"
                                 Background="{DynamicResource Layal.Panel}" BorderBrush="{DynamicResource Layal.Border}" Foreground="{DynamicResource Layal.Success}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="TaskCopyStatus" Text="" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="3,3,3,0" AutomationProperties.Name="حالة نسخ النتيجة" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="SkillsTab" Header="المهارات" Tag="&#xE8F1;">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="SkillsHeading" Text="مدير المهارات" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SkillsDescription" Grid.Row="1" Text="استورد ZIP أو رابط GitHub لمجلد مهارة. حدد حتى 3 مهارات لاستخدام نصوصها كمراجع فقط؛ السكربتات لا تُشغّل." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                    <ListBox x:Name="SkillsList" Grid.Row="2" SelectionMode="Extended" ItemsSource="{Binding InstalledSkills}" AutomationProperties.Name="المهارات المثبتة" AutomationProperties.HelpText="يمكن تحديد عدة مهارات باستخدام Ctrl أو Shift مع الأسهم." Background="{DynamicResource Layal.Panel}" BorderBrush="{DynamicResource Layal.Border}" Padding="6">
                        <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Layal.CardGradient}" CornerRadius="11" Padding="12" Margin="3" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Name}" FlowDirection="{Binding Name, Converter={StaticResource Layal.TextDirectionConverter}}" TextAlignment="{Binding Name, Converter={StaticResource Layal.TextDirectionConverter}}" FontWeight="SemiBold" Foreground="{DynamicResource Layal.Cyan}" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" FlowDirection="{Binding Description, Converter={StaticResource Layal.TextDirectionConverter}}" TextAlignment="{Binding Description, Converter={StaticResource Layal.TextDirectionConverter}}" Foreground="{DynamicResource Layal.Text}" TextWrapping="Wrap" Margin="0,4,0,4"/><TextBlock Text="{Binding ValidationStatus}" FlowDirection="{Binding ValidationStatus, Converter={StaticResource Layal.TextDirectionConverter}}" TextAlignment="{Binding ValidationStatus, Converter={StaticResource Layal.TextDirectionConverter}}" Foreground="{DynamicResource Layal.Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="SkillsEmptyStateText" Grid.Row="2"
                               Text="No skills installed. Import a ZIP or GitHub folder to get started."
                               AutomationProperties.Name="Skills empty state">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Layal.EmptyStateText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InstalledSkills.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <WrapPanel><Button x:Name="ImportSkillButton" Content="استيراد ZIP" Click="ImportSkillButton_Click"/><Button x:Name="RefreshSkillsButton" Content="تحديث القائمة" Click="RefreshSkillsButton_Click"/></WrapPanel>
                        <DockPanel Margin="0,7,0,0">
                            <Button x:Name="ImportGitHubSkillButton" Content="استيراد من GitHub" Click="ImportGitHubSkillButton_Click" DockPanel.Dock="Right"/>
                            <TextBox x:Name="GitHubSkillUrlInput" FlowDirection="LeftToRight" MinHeight="32" ToolTip="https://github.com/owner/repo/tree/main/path/to/skill" AutomationProperties.Name="رابط مستودع المهارة / Skill repository URL" AutomationProperties.HelpText="أدخل رابط مستودع أو مجلد يحتوي على SKILL.md / Enter a repository or folder containing SKILL.md."/>
                        </DockPanel>
                        <TextBlock x:Name="SkillsResult" Text="" Foreground="{DynamicResource Layal.Success}" TextWrapping="Wrap" Margin="5,5,5,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="CamerasTab" Header="الكاميرات" Tag="&#xE722;">
                <StackPanel Margin="20">
                    <TextBlock x:Name="CamerasHeading" Text="الكاميرات والرؤية الحاسوبية" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Border Background="{DynamicResource Layal.Panel}" CornerRadius="14" Padding="16" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1" Effect="{DynamicResource Layal.CardShadow}">
                        <StackPanel>
                            <TextBlock x:Name="CameraStatus" Text="غير متصل — التكامل الحقيقي غير منفذ في إصدار الأساس" Foreground="{DynamicResource Layal.Warning}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CameraDescription" Text="سيُضاف اتصال RTSP/ONVIF ومعالجة الفيديو بعد إنشاء خدمة الكاميرات واختبارها على Windows مع جهاز مصرح به. لا يعرض هذا الإصدار بثًا وهميًا." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="MemoryTab" Header="الذاكرة" Tag="&#xE7C3;">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="MemoryHeading" Text="الذاكرة الشخصية" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MemoryDescription" Text="ملاحظات تحفظها أنت. تُشفّر محليًا بحماية Windows DPAPI؛ البحث الذي يشارك النتائج مع AI يتطلب موافقة." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="MemorySearchInput" Grid.Column="0" MinHeight="32" ToolTip="بحث في الذاكرة" AutomationProperties.Name="البحث في الذاكرة / Search memory notes" AutomationProperties.HelpText="أدخل كلمات البحث ثم استخدم زر بحث / Enter search terms and use Search."/>
                        <Button x:Name="MemorySearchButton" Grid.Column="1" Content="بحث" Click="MemorySearchButton_Click"/>
                        <Button x:Name="NewMemoryButton" Grid.Column="2" Content="ملاحظة جديدة" Click="NewMemoryButton_Click"/>
                        <Button x:Name="LoreWebButton" Grid.Column="3" Content="خريطة الذاكرة 3D" Click="LoreWebButton_Click" MinWidth="135"
                                ToolTip="عرض الملاحظات وروابطها التقريبية محليًا؛ لا تُرسل إلى AI."
                                AutomationProperties.Name="فتح خريطة الذاكرة ثلاثية الأبعاد"
                                AutomationProperties.HelpText="خريطة محلية تفاعلية؛ الروابط مبنية على كلمات عنوان مشتركة والترتيب الزمني فقط، وليست استنتاجات مضمونة."/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="MemoryList" Grid.Column="0" ItemsSource="{Binding MemoryNotes}" AutomationProperties.Name="ملاحظات الذاكرة" AutomationProperties.HelpText="اختر ملاحظة لعرضها أو تعديلها." SelectionChanged="MemoryList_SelectionChanged" Background="{DynamicResource Layal.Panel}" BorderBrush="{DynamicResource Layal.Border}" Padding="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"
                                               FlowDirection="{Binding Title, Converter={StaticResource Layal.TextDirectionConverter}}"
                                               TextAlignment="{Binding Title, Converter={StaticResource Layal.TextDirectionConverter}}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Layal.Text}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="MemoryEmptyStateText" Grid.Column="0"
                                   Text="No saved notes. Create a note to get started."
                                   AutomationProperties.Name="Memory empty state">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Layal.EmptyStateText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MemoryNotes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="MemoryTitleLabel" Text="العنوان" Margin="0,0,0,4"/>
                                <TextBox x:Name="MemoryTitleInput" MinHeight="32" AutomationProperties.Name="عنوان الملاحظة / Memory note title" AutomationProperties.LabeledBy="{Binding ElementName=MemoryTitleLabel}"/>
                                <TextBlock x:Name="MemoryContentLabel" Text="المحتوى" Margin="0,10,0,4"/>
                                <TextBox x:Name="MemoryContentInput" MinHeight="160" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="محتوى الملاحظة / Memory note content" AutomationProperties.LabeledBy="{Binding ElementName=MemoryContentLabel}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="SaveMemoryButton" Content="حفظ الملاحظة" Click="SaveMemoryButton_Click"/>
                                    <Button x:Name="DeleteMemoryButton" Content="حذف" Click="DeleteMemoryButton_Click"/>
                                    <Button x:Name="ExportMemoryButton" Content="تصدير JSON" Click="ExportMemoryButton_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="MemoryResult" Text="" Foreground="{DynamicResource Layal.Success}" TextWrapping="Wrap" Margin="4,10,4,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <TextBlock x:Name="MemoryPrivacyNote" Grid.Row="3" Text="لا تحفظ مفاتيح API أو كلمات المرور في الذاكرة. تصدير JSON غير مشفر." Foreground="{DynamicResource Layal.Warning}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="ApiIntegrationsTab" Header="تكاملات API" Tag="&#xE71B;">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="ApiIntegrationsHeading" Text="ربط التطبيقات عبر API" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ApiIntegrationsDescription" Text="أضف عددًا كبيرًا من اتصالات REST/JSON وابحث بينها. يمكن تعيين اتصال متوافق مع OpenAI كـ API ليال السحابي الاختياري؛ هذا إعداد لمزود تستخدمه ليال وليس خادم API عامًا مستضافًا منها." Foreground="#63738A" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.82*"/><ColumnDefinition Width="1.18*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock x:Name="ApiConnectionsListLabel" Text="التطبيقات المتصلة" FontWeight="SemiBold" Margin="4,0,4,5"/>
                            <TextBox x:Name="ApiConnectionSearchInput" MinHeight="32" Margin="0,0,0,6"
                                     ToolTip="ابحث بالاسم أو عنوان API أو التفاصيل"
                                     AutomationProperties.Name="البحث في اتصالات API / Search API connections"
                                     AutomationProperties.HelpText="يبحث في اسم الاتصال وعنوان API والتفاصيل دون البحث في مفاتيح المصادقة."
                                     TextChanged="ApiConnectionSearchInput_TextChanged"/>
                            <ListBox x:Name="ApiConnectionList" ItemsSource="{Binding ApiConnections}" SelectionChanged="ApiConnectionList_SelectionChanged"
                                     Background="#FFFFFF" BorderBrush="#DCE5F0" Padding="5" MinHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Layal.CardGradient}" CornerRadius="10" Padding="10" Margin="2" BorderBrush="{StaticResource Layal.Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding ImagePath}" Width="44" Height="44" Stretch="UniformToFill" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#087B8F" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding BaseUrl}" Foreground="#63738A" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding ModelId}" Foreground="#63738A" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="API ليال الحالي / Current Layal API" FontSize="10" FontWeight="SemiBold" Foreground="#177A57" Margin="0,3,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLayalProvider}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="NewApiConnectionButton" Content="إضافة اتصال جديد" Click="NewApiConnectionButton_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ApiConnectionsPrivacyNote" Text="لا تشارك مفتاح API داخل المحادثة. أدخله هنا؛ سيُحفظ مشفرًا على حساب Windows الحالي." Foreground="#946200" TextWrapping="Wrap" Margin="4,8,4,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="ApiConnectionNameLabel" Text="اسم التطبيق / الاتصال" Margin="4,2,4,0"/>
                                <TextBox x:Name="ApiConnectionNameInput" MinHeight="32" ToolTip="Notion, GitHub, CRM..." />
                                <TextBlock x:Name="ApiConnectionBaseUrlLabel" Text="عنوان API الأساسي (إجباري)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiConnectionBaseUrlInput" FlowDirection="LeftToRight" MinHeight="32" ToolTip="https://api.example.com/v1"/>
                                <TextBlock x:Name="ApiConnectionModelIdLabel" Text="معرّف النموذج (اختياري، مطلوب عند استخدامه كـ API ليال)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiConnectionModelIdInput" FlowDirection="LeftToRight" MinHeight="32" ToolTip="gpt-4.1-mini or provider model ID"/>
                                <TextBlock x:Name="ApiConnectionImageLabel" Text="صورة التطبيق (اختياري)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiConnectionImagePathInput" IsReadOnly="True" MinHeight="32" ToolTip="الصورة تُنسخ إلى مجلد بيانات ليال المحلي."/>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button x:Name="ChooseApiImageButton" Content="اختيار صورة..." Click="ChooseApiImageButton_Click"/>
                                    <Button x:Name="ClearApiImageButton" Content="مسح الصورة" Click="ClearApiImageButton_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="ApiAuthTypeLabel" Text="طريقة المصادقة" Margin="4,8,4,0"/>
                                <ComboBox x:Name="ApiAuthTypeComboBox" MinHeight="32" SelectedIndex="1">
                                    <ComboBoxItem Content="بدون مصادقة / None" Tag="None"/>
                                    <ComboBoxItem Content="Bearer token" Tag="Bearer"/>
                                    <ComboBoxItem Content="Custom header (API key)" Tag="CustomHeader"/>
                                </ComboBox>
                                <TextBlock x:Name="ApiAuthHeaderNameLabel" Text="اسم ترويسة المصادقة (Custom header)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiAuthHeaderNameInput" FlowDirection="LeftToRight" Text="X-API-Key" MinHeight="32"/>
                                <TextBlock x:Name="ApiAuthSecretLabel" Text="Token / API key / header value" Margin="4,8,4,0"/>
                                <PasswordBox x:Name="ApiAuthSecretInput" FlowDirection="LeftToRight" MinHeight="32"/>
                                <TextBlock x:Name="ApiAdditionalHeadersLabel" Text="ترويسات HTTP إضافية غير سرية (JSON)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiAdditionalHeadersInput" FlowDirection="LeftToRight" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         ToolTip="Example additional header: Notion-Version"/>
                                <TextBlock x:Name="ApiTestPathLabel" Text="مسار اختبار الاتصال (GET)، مثل health أو users/me" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiTestPathInput" FlowDirection="LeftToRight" MinHeight="32"/>
                                <TextBlock x:Name="ApiInstructionsLabel" Text="التفاصيل وملاحظات API (اختياري، بدون أسرار)" Margin="4,8,4,0"/>
                                <TextBox x:Name="ApiInstructionsInput" MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         ToolTip="اكتب المسارات وطريقة الاستخدام التي تريد أن تعرفها ليال."/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="SaveApiConnectionButton" Content="حفظ الاتصال" Click="SaveApiConnectionButton_Click"/>
                                    <Button x:Name="UseAsLayalApiButton" Content="استخدام هذا كـ API ليال" Click="UseAsLayalApiButton_Click"/>
                                    <Button x:Name="TestApiConnectionButton" Content="اختبار API" Click="TestApiConnectionButton_Click" Background="{StaticResource Layal.PrimaryButtonGradient}"/>
                                    <Button x:Name="DeleteApiConnectionButton" Content="حذف الاتصال المحدد" Click="DeleteApiConnectionButton_Click" Background="#FBECEF" BorderBrush="#E9C3CC"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <TextBlock x:Name="ApiConnectionsStatus" Grid.Row="2" Text="" Foreground="#177A57" TextWrapping="Wrap" Margin="4,10,4,0"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="الإعدادات" Tag="&#xE713;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="SettingsHeading" Text="الإعدادات والاتصال" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="LanguageSettingLabel" Text="لغة الواجهة" FontWeight="SemiBold" Margin="4,8,4,0"/>
                        <WrapPanel><Button x:Name="ArabicLanguageButton" Content="العربية" Click="ArabicLanguageButton_Click"/><Button x:Name="EnglishLanguageButton" Content="English" Click="EnglishLanguageButton_Click"/></WrapPanel>

                        <Separator Margin="4,10" Background="{DynamicResource Layal.Border}"/>
                        <TextBlock x:Name="WeatherSettingsTitle" Text="حالة الطقس في الرئيسية"
                                   FontSize="16" FontWeight="SemiBold" Margin="4,8,4,4"/>
                        <Button x:Name="UseMyLocationButton" Content="اكتشاف موقعي واستخدامه تلقائيًا"
                                Click="UseMyLocationButton_Click" Margin="4,5,4,0"
                                AutomationProperties.Name="اكتشاف الموقع الحالي"
                                AutomationProperties.HelpText="يطلب السماح من Windows لقراءة موقع تقريبي، ثم يستخدمه للوقت والتاريخ والطقس."/>
                        <TextBlock x:Name="WeatherLocationLabel" Text="مدينة بديلة عند عدم إتاحة الموقع"
                                   Margin="4,5,4,0"/>
                        <TextBox x:Name="WeatherLocationInput" FlowDirection="LeftToRight"
                                 ToolTip="مثال: Cairo, Egypt أو القاهرة، مصر"
                                 AutomationProperties.Name="مدينة الطقس"
                                 AutomationProperties.LabeledBy="{Binding ElementName=WeatherLocationLabel}"
                                 AutomationProperties.HelpText="اختياري: اكتب مدينة لاستخدامها يدويًا بدلًا من تحديد موقع الجهاز."/>
                        <WrapPanel Margin="0,5,0,0">
                            <Button x:Name="SaveWeatherLocationButton" Content="استخدام المدينة يدويًا"
                                    Click="SaveWeatherLocationButton_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="WeatherPrivacyNote"
                                   Text="عند تفعيل الموقع، يطلب التطبيق الإذن من Windows ويرسل الإحداثيات إلى Open-Meteo لحساب الطقس والمنطقة الزمنية. لا يحفظ التطبيق الإحداثيات؛ ويمكن استخدام مدينة يدويًا بدلًا من ذلك."
                                   Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap"
                                   Margin="4,4,4,8" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="WeatherSettingsStatus" Text="" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Layal.Success}" Margin="4,0,4,8"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Separator Margin="4,10" Background="{DynamicResource Layal.Border}"/>
                        <TextBlock x:Name="LocalAiSectionTitle" Text="الشات والصوت المحليان (الافتراضي)" FontSize="16" FontWeight="SemiBold" Margin="4,8,4,4"/>
                        <CheckBox x:Name="UseLocalAiCheckbox" Content="استخدام الذكاء الاصطناعي المحلي دون مفتاح API"
                                  IsChecked="True" Checked="LocalAiModeSettingChanged" Unchecked="LocalAiModeSettingChanged"
                                  AutomationProperties.Name="وضع الذكاء الاصطناعي المحلي"
                                  AutomationProperties.HelpText="الشات وتحويل الكلام والنطق يعملون على هذا الجهاز. ألغِ التحديد لاستخدام مزود سحابي تم إعداده في الأسفل."/>
                        <TextBlock x:Name="LocalAiDescription"
                                   Text="أول مرة فقط: بعد موافقتك، سيُنزل Layal محرك Ollama ونموذج الشات وموارد الصوت المحلي. يحتاج الإعداد إنترنت ومساحة فارغة؛ بعد التنزيل تتم معالجة الرسائل والصوت على جهازك."
                                   Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="4,5,4,5"/>
                        <Button x:Name="SetupLocalAiButton" Content="تجهيز الشات والصوت المحليين" Click="SetupLocalAiButton_Click"
                                HorizontalAlignment="Left" AutomationProperties.Name="تجهيز الشات والصوت المحليين"/>
                        <Button x:Name="CancelLocalAiSetupButton" Content="إلغاء التنزيل" Click="CancelLocalAiSetupButton_Click"
                                HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,6,0,0"
                                AutomationProperties.Name="إلغاء تنزيل موارد الذكاء الاصطناعي المحلي"
                                AutomationProperties.HelpText="يمكن أيضًا الضغط على Esc لإلغاء تنزيل الموارد المحلية."/>
                        <ProgressBar x:Name="LocalAiProgressBar" Minimum="0" Maximum="100" Height="8" Margin="4,6,4,0"
                                     Visibility="Collapsed" AutomationProperties.Name="تقدم إعداد الذكاء الاصطناعي المحلي"/>
                        <TextBlock x:Name="LocalAiStatusText" Text="لم يُنزّل أي نموذج بعد؛ لن يبدأ التنزيل قبل موافقتك."
                                   Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="4,5,4,8"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="حالة الشات والصوت المحليين"/>
                        <Separator Margin="4,10" Background="{DynamicResource Layal.Border}"/>
                        <TextBlock x:Name="ProviderSectionTitle" Text="مزود سحابي اختياري (OpenAI-compatible)" FontSize="16" FontWeight="SemiBold" Margin="4,8,4,4"/>
                        <TextBlock x:Name="EndpointLabel" Text="Base URL" Margin="4,5,4,0"/>
                        <TextBox x:Name="BaseUrlInput" FlowDirection="LeftToRight" Text="http://127.0.0.1:31415/v1" AutomationProperties.Name="عنوان API الأساسي / API base URL" AutomationProperties.LabeledBy="{Binding ElementName=EndpointLabel}" AutomationProperties.HelpText="عنوان الخدمة الأساسية بصيغة HTTP أو HTTPS / HTTP or HTTPS base URL for the provider."/>
                        <TextBlock x:Name="ModelLabel" Text="معرّف النموذج" Margin="4,5,4,0"/>
                        <TextBox x:Name="ModelInput" FlowDirection="LeftToRight" Text="auto" AutomationProperties.Name="معرّف النموذج / Model ID" AutomationProperties.LabeledBy="{Binding ElementName=ModelLabel}"/>
                        <TextBlock x:Name="SpeechModelLabel" Text="نموذج تحويل الكلام السحابي (اختياري)" Margin="4,8,4,0"/>
                        <TextBox x:Name="SpeechModelInput" FlowDirection="LeftToRight" Text="gpt-transcribe" AutomationProperties.Name="معرّف نموذج تحويل الكلام إلى نص / Speech-to-text model ID" AutomationProperties.LabeledBy="{Binding ElementName=SpeechModelLabel}" ToolTip="الافتراضي gpt-transcribe؛ تحقق من دعم موفر API للنموذج ونقطة النهاية."/>
                        <Separator Margin="4,10" Background="{DynamicResource Layal.Border}"/>
                        <TextBlock x:Name="VoiceReplySectionTitle" Text="صوت ليال" FontSize="16" FontWeight="SemiBold" Margin="4,8,4,4"/>
                        <CheckBox x:Name="VoiceReplyCheckbox" Content="ليال تقرأ ردودها بصوت" IsChecked="True" Checked="VoiceReplySettingChanged" Unchecked="VoiceReplySettingChanged" AutomationProperties.Name="الردود الصوتية لليال" AutomationProperties.HelpText="بعد اكتمال الرد النصي، يُرسل النص إلى Realtime لتوليد صوت اصطناعي طفولي وناعم."/>
                        <TextBlock x:Name="VoiceReplyVoiceLabel" Text="نبرة الصوت السحابي (اختياري)" Margin="4,6,4,0"/>
                        <ComboBox x:Name="VoiceReplyVoiceSelector" SelectedValuePath="Tag" SelectedValue="marin" SelectionChanged="VoiceReplyVoiceSelector_SelectionChanged" MinWidth="260" AutomationProperties.Name="صوت ليال الطفولي">
                            <ComboBoxItem Tag="shimmer" Content="طفولي وناعم (Shimmer)"/>
                            <ComboBoxItem Tag="coral" Content="طفولي ودافئ (Coral)"/>
                            <ComboBoxItem Tag="marin" Content="طبيعي وعفوي (Marin)"/>
                            <ComboBoxItem Tag="cedar" Content="هادئة وواضحة (Cedar)"/>
                        </ComboBox>
                        <TextBlock x:Name="AssistantPersonaLabel" Text="نمط شخصية ليال" Margin="4,8,4,0"/>
                        <ComboBox x:Name="AssistantPersonaSelector" SelectedValuePath="Tag" MinWidth="260" MinHeight="32"
                                  SelectionChanged="AssistantPersonaSelector_SelectionChanged"
                                  AutomationProperties.Name="نمط شخصية ليال"
                                  AutomationProperties.HelpText="اختيار الأسلوب يغيّر طريقة الصياغة فقط ولا يغيّر قواعد الأمان أو الموافقات أو الصلاحيات.">
                            <ComboBoxItem Tag="warm" Content="رفيقة دافئة"/>
                            <ComboBoxItem Tag="focused" Content="مركزة ومختصرة"/>
                            <ComboBoxItem Tag="professional" Content="احترافية ومنظمة"/>
                        </ComboBox>
                        <TextBlock x:Name="AssistantPersonaDisclosure" Text="نمط الرد يغيّر طريقة الصياغة فقط، ولا يغيّر الهوية أو حدود الأمان."
                                   Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="4,4,4,8"
                                   AutomationProperties.Name="حدود نمط الشخصية"/>
                        <TextBlock x:Name="VoiceReplyModelLabel" Text="معرّف نموذج الصوت السحابي (Realtime؛ اختياري)" Margin="4,8,4,0"/>
                        <TextBox x:Name="VoiceReplyModelInput" FlowDirection="LeftToRight" Text="gpt-realtime-2.1-mini" AutomationProperties.Name="معرّف نموذج الرد الصوتي" AutomationProperties.LabeledBy="{Binding ElementName=VoiceReplyModelLabel}"/>
                        <TextBlock x:Name="VoiceReplyDisclosureText" Text="صوت ليال اصطناعي وليس صوت إنسان. في الوضع المحلي يُولّد النطق على جهازك؛ عند اختيار المزود السحابي قد تُطبق رسوم." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="4,5,4,4" AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="TestVoiceReplyButton" Content="تجربة صوت ليال" Click="TestVoiceReplyButton_Click" HorizontalAlignment="Left" ToolTip="يختبر الصوت محليًا في الوضع المحلي، أو يستخدم موفر Realtime عند اختيار الوضع السحابي."/>

                        <TextBlock x:Name="ApiKeyLabel" Text="Unified API Key / API Key" Margin="4,5,4,0"/>
                        <PasswordBox x:Name="ApiKeyInput" FlowDirection="LeftToRight" AutomationProperties.Name="مفتاح API / API key" AutomationProperties.LabeledBy="{Binding ElementName=ApiKeyLabel}" AutomationProperties.HelpText="يُحفظ المفتاح مشفرًا لمستخدم Windows الحالي / The API key is saved encrypted for the current Windows user."/>
                        <TextBlock x:Name="KeyStorageNote" Text="يُحفظ المفتاح باستخدام Windows DPAPI للمستخدم الحالي، ولا يظهر في الإعدادات النصية." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="4,4"/>
                        <WrapPanel><Button x:Name="SaveProviderButton" Content="حفظ الإعدادات" Click="SaveProviderButton_Click"/><Button x:Name="TestProviderButton" Content="اختبار الاتصال" Click="TestProviderButton_Click" Background="{DynamicResource Layal.PrimaryButtonGradient}"/><Button x:Name="DeleteKeyButton" Content="حذف المفتاح المحفوظ" Click="DeleteKeyButton_Click" Background="{DynamicResource Layal.DangerSurface}" BorderBrush="{DynamicResource Layal.DangerBorder}"/></WrapPanel>
                        <TextBlock x:Name="ProviderActionStatus" Text="" Foreground="{DynamicResource Layal.Success}" TextWrapping="Wrap" Margin="5,8,5,12" AutomationProperties.LiveSetting="Polite"/>
                        <Separator Margin="4,10" Background="{DynamicResource Layal.Border}"/>
                        <Separator Margin="4,10" Background="{DynamicResource Layal.Border}"/>
                        <TextBlock x:Name="ThemePresetLabel" Text="مجموعة ألوان الواجهة" Margin="4,5,4,0"/>
                        <ComboBox x:Name="ThemePresetSelector" MinHeight="32" MinWidth="240" SelectedValuePath="Tag"
                                  SelectionChanged="ThemePresetSelector_SelectionChanged"
                                  AutomationProperties.Name="مجموعة ألوان الواجهة"
                                  AutomationProperties.HelpText="اختر Classic أو Ocean أو Forest أو Sunset. يمكن التبديل بين الفاتح والداكن بشكل مستقل، ويتقدم High Contrast الخاص بـ Windows على جميع المجموعات.">
                            <ComboBoxItem Tag="classic" Content="Classic — الكلاسيكي"/>
                            <ComboBoxItem Tag="ocean" Content="Ocean — المحيط"/>
                            <ComboBoxItem Tag="forest" Content="Forest — الغابة"/>
                            <ComboBoxItem Tag="sunset" Content="Sunset — الغروب"/>
                        </ComboBox>
                        <TextBlock x:Name="ThemePresetPrivacyNote" Text="مجموعة الألوان إعداد محلي. تظل إعدادات التباين العالي في Windows هي الأولوية."
                                   Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="4,4,4,8"
                                   AutomationProperties.Name="ملاحظة أولوية التباين العالي"/>
                        <TextBlock x:Name="MascotSettingsTitle" Text="إعدادات الشخصية العائمة" FontSize="16" FontWeight="SemiBold" Margin="4,8,4,4"/>
                        <CheckBox x:Name="AlwaysOnTopCheckbox" Content="إبقاء الشخصية فوق النوافذ الأخرى" Checked="MascotSettingChanged" Unchecked="MascotSettingChanged"/>
                        <CheckBox x:Name="AnimationsCheckbox" Content="تفعيل حركة الشخصية والرمش" Checked="MascotSettingChanged" Unchecked="MascotSettingChanged"/>
                        <CheckBox x:Name="WindowInspectionCheckbox" Content="السماح بقراءة عناوين النوافذ عند الطلب (يتطلب موافقة قبل مشاركتها مع AI)" Checked="WindowInspectionSettingChanged" Unchecked="WindowInspectionSettingChanged"/>
                        <TextBlock x:Name="MascotSizeLabel" Text="حجم الشخصية" Margin="4,8,4,0"/>
                        <Slider x:Name="MascotSizeSlider" Minimum="0.65" Maximum="1.8" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="False" Margin="4,4" AutomationProperties.LabeledBy="{Binding ElementName=MascotSizeLabel}"/>
                        <TextBlock x:Name="MascotOpacityLabel" Text="شفافية الشخصية" Margin="4,8,4,0"/>
                        <Slider x:Name="MascotOpacitySlider" Minimum="0.35" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="False" Margin="4,4" AutomationProperties.LabeledBy="{Binding ElementName=MascotOpacityLabel}"/>
                        <Button x:Name="ApplyMascotSettingsButton" Content="تطبيق إعدادات الشخصية" Click="ApplyMascotSettingsButton_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="SettingsLimitations" Text="المتصفح، والتحكم العام في Windows، والصوت، والبث الحقيقي للكاميرات ليست منفذة بعد في إصدار الأساس. لا يتم عرضها كوظائف مكتملة." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="5,14,5,5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Sidebar overlay: brand on top and app controls at the bottom of the glass sidebar.
             Row heights (88 / * / 156) and width (244) mirror the reserved areas in the TabControl template. -->
        <Grid x:Name="SidebarOverlay" Grid.Row="1" Margin="16,0,16,16" Width="244" HorizontalAlignment="Left" KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="156"/></Grid.RowDefinitions>
            <StackPanel x:Name="SidebarBrandRow" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,12,0">
                <Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource Layal.AccentGradient}" Margin="0,0,12,0">
                    <Grid>
                        <TextBlock Text="L" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Layal.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Layal.DecorativeAmber}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Width="146">
                    <TextBlock x:Name="TitleText" Text="Layal | ليال" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" Text="وكيل ذكاء اصطناعي مستقل لسطح المكتب" Foreground="{DynamicResource Layal.Muted}" FontSize="11" TextWrapping="Wrap" MaxHeight="30" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="SidebarFooterPanel" Grid.Row="2" Margin="14,0,14,14" VerticalAlignment="Bottom">
                <Border CornerRadius="11" Background="{DynamicResource Layal.Panel}" Padding="12,8" Margin="3,3,3,6" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1">
                    <TextBlock x:Name="ConnectionStatusText" Text="AI: Not connected" Foreground="{DynamicResource Layal.Warning}" FontSize="12" FontWeight="SemiBold" AutomationProperties.Name="حالة اتصال المزود" AutomationProperties.LiveSetting="Polite"/>
                </Border>
                <UniformGrid Columns="2">
                    <Button x:Name="LanguageButton" Content="English" Click="LanguageButton_Click" MinWidth="82" Padding="6,6" Margin="3" FontSize="12" MinHeight="34"/>
                    <Button x:Name="ThemeButton" Content="الوضع الداكن" Click="ThemeButton_Click" MinWidth="96" Padding="6,6" Margin="3" FontSize="12" MinHeight="34"/>
                </UniformGrid>
                <UniformGrid Columns="2">
                    <Button x:Name="KeyboardHelpButton" Content="_اختصارات" Click="KeyboardHelpButton_Click" MinWidth="78" Padding="6,6" Margin="3" FontSize="12" MinHeight="34"/>
                    <Button x:Name="ShowMascotButton" Content="إظهار الشخصية" Click="ShowMascotButton_Click" Padding="6,6" Margin="3" FontSize="12" MinHeight="34"/>
                </UniformGrid>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
