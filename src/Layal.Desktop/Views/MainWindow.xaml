<Window x:Class="Layal.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Layal | ليال" Icon="pack://application:,,,/Layal;component/Assets/layal-tray.ico" Width="1320" Height="860" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Layal.Backdrop}" Foreground="{DynamicResource Layal.Text}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" Loaded="MainWindow_Loaded" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Layered aurora glow behind the frosted panels: decorative only, never intercepts input. -->
        <Grid x:Name="AmbientGlassLayer" Grid.Row="0" Grid.RowSpan="2"
              IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-190,-205,0,0" Fill="{DynamicResource Layal.GlowBlueBrush}" Opacity="0.88">
                
            </Ellipse>
            <Ellipse Width="440" Height="440" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-145,210,0" Fill="{DynamicResource Layal.GlowVioletBrush}" Opacity="0.78">
                
            </Ellipse>
            <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-195,-225" Fill="{DynamicResource Layal.GlowPinkBrush}" Opacity="0.82">
                
            </Ellipse>
        </Grid>
        <!-- Custom caption: the empty area remains draggable; status indicators and caption buttons stay interactive. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                    KeyboardNavigation.TabNavigation="Local">
<Border x:Name="VoiceConversationIndicator" shell:WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" CornerRadius="11"
                            Background="{DynamicResource Layal.Panel}" Padding="10,8" Margin="4"
                            BorderBrush="{DynamicResource Layal.DangerBorder}" BorderThickness="1"
                            AutomationProperties.Name="حالة الميكروفون للمحادثة الصوتية" AutomationProperties.LiveSetting="Polite">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="VoiceConversationMicDot" Width="9" Height="9" Fill="{DynamicResource Layal.Danger}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="VoiceConversationMicStatus" Text="الميكروفون نشط" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Layal.Text}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
<Border x:Name="CameraVisionIndicator" shell:WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" CornerRadius="11"
                            Background="{DynamicResource Layal.Panel}" Padding="10,8" Margin="4"
                            BorderBrush="{DynamicResource Layal.DangerBorder}" BorderThickness="1"
                            AutomationProperties.Name="حالة كاميرا الرؤية" AutomationProperties.LiveSetting="Polite">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="CameraVisionDot" Width="9" Height="9" Fill="{DynamicResource Layal.Danger}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="CameraVisionStatusText" Text="الكاميرا نشطة" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Layal.Text}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
            <Button x:Name="MinimizeWindowButton" Style="{StaticResource Layal.CaptionButton}" Content="&#xE921;" Click="MinimizeWindowButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="تصغير / Minimize" AutomationProperties.Name="تصغير / Minimize" />
            <Button x:Name="MaximizeWindowButton" Style="{StaticResource Layal.CaptionButton}" Content="&#xE922;" Click="MaximizeWindowButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="تكبير أو استعادة / Maximize or restore" AutomationProperties.Name="تكبير أو استعادة / Maximize or restore" />
            <Button x:Name="CloseWindowButton" Style="{StaticResource Layal.CaptionButton}" Content="&#xE8BB;" Click="CloseWindowButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="إغلاق / Close" AutomationProperties.Name="إغلاق / Close" />
        </StackPanel>
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,0,16,16" Background="Transparent" BorderBrush="Transparent" KeyboardNavigation.TabNavigation="Local" SelectionChanged="MainTabs_SelectionChanged" AutomationProperties.Name="التنقل الرئيسي / Main navigation" AutomationProperties.HelpText="استخدم Ctrl+1 إلى Ctrl+8 للتنقل بين التبويبات / Use Ctrl+1 to Ctrl+8 to navigate the tabs.">
            <TabItem x:Name="HomeTab" Header="الرئيسية" Tag="&#xE80F;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <Grid Margin="0,0,0,20" MinHeight="176">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="HomeHeading" Text="أهلًا، أنا ليال" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="HomeDescription" Text="هذه النسخة هي الأساس الأصلي لتطبيق Windows. ابدأ بربط نموذج حقيقي من الإعدادات." Foreground="{DynamicResource Layal.Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,0"/>
                            </StackPanel>
                            <Image x:Name="HomeLayalImage"
                                   Grid.Column="1" Width="176" Height="172"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Layal;component/Assets/Characters/layal-idle.png"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   IsHitTestVisible="False" Focusable="False" />
                        </Grid>


                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,12">
                            <Border Background="{DynamicResource Layal.CardGradient}" CornerRadius="16" Padding="20" Margin="5" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1" Effect="{DynamicResource Layal.CardShadow}">
                                <StackPanel><TextBlock x:Name="CardAiTitle" Text="اتصال الذكاء الاصطناعي" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CardAiValue" Text="غير متصل" Foreground="{DynamicResource Layal.Warning}" Margin="0,8,0,0"/><TextBlock x:Name="CardAiHint" Text="أدخل عنوان API والمفتاح من الإعدادات" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Layal.CardGradient}" CornerRadius="16" Padding="20" Margin="5" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1" Effect="{DynamicResource Layal.CardShadow}">
                                <StackPanel><TextBlock x:Name="CardMascotTitle" Text="الشخصية العائمة" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CardMascotValue" Text="نافذة Windows أصلية" Foreground="{DynamicResource Layal.Success}" Margin="0,8,0,0"/><TextBlock x:Name="CardMascotHint" Text="اسحب ليال في سطح المكتب، وانقر مرتين لفتح الواجهة." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Layal.CardGradient}" CornerRadius="16" Padding="20" Margin="5" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1" Effect="{DynamicResource Layal.CardShadow}">
                                <StackPanel><TextBlock x:Name="CardToolsTitle" Text="أدوات Windows" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CardToolsValue" Text="أداة آمنة متاحة" Foreground="{DynamicResource Layal.Success}" Margin="0,8,0,0"/><TextBlock x:Name="CardToolsHint" Text="يمكنك تجربة فتح المفكرة من الزر أدناه." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Layal.CardGradient}" CornerRadius="16" Padding="20" Margin="5" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1" Effect="{DynamicResource Layal.CardShadow}">
                                <StackPanel><TextBlock x:Name="CardSkillsTitle" Text="مدير المهارات" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CardSkillsValue" Text="استيراد ZIP مع التحقق" Foreground="{DynamicResource Layal.Success}" Margin="0,8,0,0"/><TextBlock x:Name="CardSkillsHint" Text="يتم فحص SKILL.md وحفظ الحزمة دون تشغيل سكربتاتها." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <WrapPanel Margin="0,4,0,10">
                            <Button x:Name="OpenNotepadButton" Content="فتح المفكرة (اختبار فعلي)" Click="OpenNotepadButton_Click" Background="{DynamicResource Layal.PrimaryButtonGradient}"/>
                            <Button x:Name="GoChatButton" Content="فتح المحادثة" Click="GoChatButton_Click"/>
                            <Button x:Name="GoSettingsButton" Content="إعداد اتصال AI" Click="GoSettingsButton_Click"/>
                        </WrapPanel>
                        <Border Background="{DynamicResource Layal.HeaderGradient}" CornerRadius="14" Padding="16" Margin="4,8,4,0" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1" Effect="{DynamicResource Layal.CardShadow}">
                            <TextBlock x:Name="HomeCaveat" Text="الوظائف غير المكتملة لن يتم عرضها كأنها تعمل: الصوت، والتحكم العام في Windows، وأتمتة المتصفح، والبث الحقيقي للكاميرات ستضاف في مراحل لاحقة." Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock x:Name="HomeResult" Text="" Foreground="{DynamicResource Layal.Success}" TextWrapping="Wrap" Margin="6,12,6,0" AutomationProperties.Name="نتيجة الإجراء" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ChatTab" Header="المحادثة" Tag="&#xE8BD;">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="3,0,3,8" Padding="16,10" CornerRadius="22" Background="{DynamicResource Layal.GlassStrongFill}"
                            BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="LAYAL  /  مساعد سطح المكتب" FlowDirection="RightToLeft"
                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Layal.Cyan}"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="ChatHeading" Text="المحادثة مع ليال" FontSize="25"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="ChatProviderStatus" DockPanel.Dock="Right" Text="لا يوجد اتصال مختبَر"
                                       Foreground="{DynamicResource Layal.Warning}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="190" AutomationProperties.Name="حالة اتصال المزود"/>
                        </DockPanel>
                        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <ComboBox x:Name="ChatHistorySelector" ItemsSource="{Binding ChatConversations}" DisplayMemberPath="Title"
                                      SelectionChanged="ChatHistorySelector_SelectionChanged" MinWidth="164" MaxWidth="260"
                                      ToolTip="المحادثات المحفوظة" AutomationProperties.Name="المحادثات المحفوظة / Saved conversations" AutomationProperties.HelpText="اختر محادثة محفوظة لاستكمالها / Select a saved conversation to continue." VerticalContentAlignment="Center"/>
                            <Button x:Name="CopyChatButton" Content="نسخ الشات" Click="CopyChatButton_Click"
                                    ToolTip="نسخ المحادثة كاملة إلى الحافظة"/>
                            <Button x:Name="NewConversationButton" Content="محادثة جديدة" Click="NewConversationButton_Click"/>
                            <Button x:Name="ClearSavedChatHistoryButton" Content="مسح السجل المحفوظ" Click="ClearSavedChatHistoryButton_Click"
                                    Background="{DynamicResource Layal.DangerSurface}" BorderBrush="{DynamicResource Layal.DangerBorder}"/>
                        </WrapPanel>
                    </Grid>
                            <Image Grid.Column="1" Width="76" Height="76" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Layal;component/Assets/Characters/layal-idle.png"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   IsHitTestVisible="False" Focusable="False" />
                        </Grid>
                    </Border>

                    <Border x:Name="ClockWeatherCard" Grid.Row="1" Background="{DynamicResource Layal.GlassFill}"
                                                    CornerRadius="18" Padding="10" Margin="3,0,3,6"
                                                    BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
                                                    Effect="{DynamicResource Layal.CardShadow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,14,0">
                                                        <TextBlock x:Name="ClockSectionTitle" Text="الوقت والتاريخ"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Layal.Muted}"/>
                                                        <TextBlock x:Name="ClockTimeText" Text="--:--:--"
                                                                   FontSize="26" FontWeight="SemiBold" Margin="0,3,0,0"
                                                                   AutomationProperties.Name="الوقت المحلي"/>
                                                        <TextBlock x:Name="CurrentDateText" Text="جارٍ تحميل التاريخ"
                                                                   FontSize="13" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Layal.Muted}" Margin="0,2,0,0"
                                                                   AutomationProperties.Name="التاريخ المحلي"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="1" Height="62"
                                                            Background="{DynamicResource Layal.Border}" Margin="8,0"/>
                                                    <Grid Grid.Column="2" Margin="10,0,10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="WeatherIconText" Grid.Column="0" Text="🌍"
                                                                   FontSize="30" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                   AutomationProperties.Name="رمز حالة الطقس"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock x:Name="WeatherSectionTitle" Text="الطقس"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Layal.Muted}"/>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock x:Name="WeatherTemperatureText" Text="—°C"
                                                                           FontSize="22" FontWeight="SemiBold" Margin="0,2,8,0"
                                                                           AutomationProperties.Name="درجة الحرارة الحالية"/>
                                                                <TextBlock x:Name="WeatherSummaryText" Text="سيتم تحديد موقعك تلقائيًا"
                                                                           FontSize="13" VerticalAlignment="Center"
                                                                           TextWrapping="Wrap" MaxWidth="300"/>
                                                            </StackPanel>
                                                            <TextBlock x:Name="WeatherLocationText" Text="لم تُحدّد مدينة"
                                                                       FontSize="12" Foreground="{DynamicResource Layal.Muted}"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       AutomationProperties.Name="مدينة الطقس"/>
                                                            <TextBlock x:Name="WeatherDetailsText" Text=""
                                                                       FontSize="12" Foreground="{DynamicResource Layal.Muted}"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            <TextBlock x:Name="WeatherUpdatedText" Text=""
                                                                       FontSize="11" Foreground="{DynamicResource Layal.Muted}"
                                                                       Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Button x:Name="RefreshWeatherButton" Grid.Column="3"
                                                            Content="تحديث الطقس" Click="RefreshWeatherButton_Click"
                                                            VerticalAlignment="Center" Margin="4,0,0,0" MinWidth="92"
                                                            AutomationProperties.Name="تحديث حالة الطقس"
                                                            AutomationProperties.HelpText="يجلب الطقس للمدينة المحددة في الإعدادات."/>
                                                </Grid>
                                            </Border>
                    <Border x:Name="ChatMessagesShell" Grid.Row="2" Margin="3,0,3,6" CornerRadius="22"
                            Background="{DynamicResource Layal.GlassFill}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}"
                            BorderThickness="1" Effect="{DynamicResource Layal.CardShadow}" IsHitTestVisible="False"/>
                    <ListBox x:Name="ChatMessagesList" Grid.Row="2" Margin="5,3,5,9" ItemsSource="{Binding ChatMessages}" Background="Transparent" BorderThickness="0" Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="رسائل المحادثة" AutomationProperties.HelpText="استخدم الأسهم لاستعراض رسائل المحادثة.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Bubble" Background="{DynamicResource Layal.GlassStrongFill}" CornerRadius="20" Padding="15,10" Margin="6,4"
                                        BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1" MaxWidth="640" HorizontalAlignment="Left">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="ChatMessageContextMenu_Opening">
                                            <MenuItem Header="نسخ الرسالة" Click="CopyChatMessage_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <TextBlock x:Name="RoleText" Text="{Binding DisplayRole}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Layal.Cyan}" Margin="0,0,0,4"/>
                                        <emoji:TextBlock x:Name="BodyText" Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource Layal.Text}"
                                                         FlowDirection="{Binding Direction}"
                                                         TextAlignment="{Binding Direction, Converter={StaticResource Layal.TextDirectionConverter}}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                        <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Layal.AccentGradient}"/>
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="Transparent"/>
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="RoleText" Property="Foreground" Value="{DynamicResource Layal.OnAccent}"/>
                                        <Setter TargetName="BodyText" Property="Foreground" Value="{DynamicResource Layal.OnAccent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ChatEmptyStateText" Grid.Row="2"
                               Text="No messages yet. Type a message below to start the conversation."
                               AutomationProperties.Name="Chat empty state"
                               AutomationProperties.HelpText="The message list becomes populated after you send or receive a message.">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Layal.EmptyStateText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChatMessages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border x:Name="ChatStatusShell" Grid.Row="3" Margin="3,0,3,6" CornerRadius="18"
                            Background="{DynamicResource Layal.GlassFill}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}"
                            BorderThickness="1" IsHitTestVisible="False"/>
                    <StackPanel Grid.Row="3" Margin="10,3">
                        <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,2">
                            <Button x:Name="QuickAskButton" Content="سؤال سريع" Click="QuickAskButton_Click" MinWidth="100"
                                    ToolTip="اسأل كتابةً من أي برنامج. الاختصار Alt+Shift+S."
                                    AutomationProperties.Name="سؤال سريع"
                                    AutomationProperties.HelpText="يفتح نافذة كتابة صغيرة. لا تُلتقط الشاشة أو تُرسل ملفات تلقائيًا."/>
                            <Button x:Name="GmailInboxButton" Content="Gmail" Click="GmailInboxButton_Click" MinWidth="85"
                                    ToolTip="عرض بريد Gmail محليًا بصلاحية قراءة فقط. لا تتم مشاركته مع AI تلقائيًا."
                                    AutomationProperties.Name="فتح بريد Gmail للقراءة فقط"
                                    AutomationProperties.HelpText="يتطلب موافقة Google الرسمية. يمكن عرض الرسائل محليًا؛ لا إرسال أو حذف أو تعديل، ولا مشاركة مع AI حتى تنسخ الرسالة لمسودة الشات وتضغط إرسال."/>
                            <Button x:Name="PrivacyShieldButton" Content="درع الخصوصية: مغلق" Click="PrivacyShieldButton_Click" MinWidth="155"
                                    ToolTip="إيقاف بدء التقاط الميكروفون والكاميرا والشاشة والحافظة."
                                    AutomationProperties.Name="مفتاح خصوصية شامل"
                                    AutomationProperties.HelpText="عند التفعيل يمنع بدء التسجيل والكاميرا وقص الشاشة وقراءة الحافظة، ويحاول إيقاف الالتقاطات الجارية. تظل الدردشة النصية متاحة."/>
                            <Button x:Name="IncognitoModeButton" Content="محادثة خاصة" Click="IncognitoModeButton_Click" MinWidth="110"
                                    ToolTip="جلسة دردشة مؤقتة لا تحفظ رسائلها محليًا؛ تظل بيانات الإرسال للمزود حسب إعداداتك."
                                    AutomationProperties.Name="محادثة خاصة"
                                    AutomationProperties.HelpText="يخفي سجل المحادثات ويبدأ سياقًا مؤقتًا. لا يعطل حفظ سجلات المهام أو الذاكرة."/>
                            <Button x:Name="CaptureScreenRegionButton" Content="قص جزء من الشاشة" Click="CaptureScreenRegionButton_Click"
                                    ToolTip="يلتقط الشاشة الموجودة على الشاشة الحالية بعد موافقتك، ويعرض معاينة لقص منطقة قبل الإرفاق."
                                    MinWidth="135" AutomationProperties.Name="التقاط وقص جزء من الشاشة"
                                    AutomationProperties.HelpText="يُلتقط المحتوى محليًا بعد موافقتك، وتظهر معاينة لتحديد مستطيل. لا تُرسل الصورة إلا عند الضغط على إرسال."/>
                            <Button x:Name="InspectHoveredElementButton" Content="السؤال عن عنصر" Click="InspectHoveredElementButton_Click"
                                    ToolTip="بعد موافقتك، اقرأ اسم ونوع عنصر Windows أسفل المؤشر محليًا دون التقاط الشاشة."
                                    MinWidth="120" AutomationProperties.Name="فحص عنصر أسفل المؤشر"
                                    AutomationProperties.HelpText="تُقرأ خصائص واجهة محدودة فقط بعد موافقتك. لا تُقرأ قيم الحقول ولا تُرسل النتيجة إلا بعد ضغط إرسال."/>
                            <Button x:Name="ChooseImageButton" Content="إرفاق صورة/لقطة شاشة" Click="ChooseImageButton_Click"
