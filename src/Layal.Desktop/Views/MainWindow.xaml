                                Background="{DynamicResource Layal.NavSelected}"
                                BorderBrush="{DynamicResource Layal.GlassBorderBrush}"
                                Click="ToggleBottomDockButton_Click" ToolTip="طي شريط التنقل الجانبي"
                                AutomationProperties.AutomationId="ToggleBottomDockButton"
                                AutomationProperties.Name="طي شريط التنقل الجانبي"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Border x:Name="DockExpandedSurface" Width="166" Opacity="1" ClipToBounds="True"
                                IsHitTestVisible="True" VerticalAlignment="Top">
                            <StackPanel x:Name="DockNavigationItems" Orientation="Vertical"
                                        FlowDirection="LeftToRight" KeyboardNavigation.TabNavigation="Local">
                                <TextBlock Text="WORKSPACE  /  مساحة العمل" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Layal.Muted}" Margin="8,0,4,8"/>
                                <Button x:Name="DockChatButton" Content="✦  الرئيسية" Click="DockChatButton_Click"
                                        Width="152" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="12,10" Margin="2,3" FontSize="12" MinHeight="44"
                                        Background="Transparent" BorderBrush="Transparent"
                                        ToolTip="العودة إلى المحادثة"
                                        AutomationProperties.AutomationId="DockChatButton"
                                        AutomationProperties.Name="الرئيسية - المحادثة"/>
                                <Button x:Name="DockOverviewButton" Content="⌂  نظرة عامة" Click="DockOverviewButton_Click"
                                        Width="152" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="12,10" Margin="2,3" FontSize="12" MinHeight="44"
                                        Background="Transparent" BorderBrush="Transparent"
                                        AutomationProperties.AutomationId="DockOverviewButton"
                                        AutomationProperties.Name="نظرة عامة"/>
                                <Button x:Name="DockTasksButton" Content="▣  المهام" Click="DockTasksButton_Click"
                                        Width="152" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="12,10" Margin="2,3" FontSize="12" MinHeight="44"
                                        Background="Transparent" BorderBrush="Transparent"
                                        AutomationProperties.AutomationId="DockTasksButton"
                                        AutomationProperties.Name="المهام"/>
                                <Button x:Name="DockSkillsButton" Content="◇  المهارات" Click="DockSkillsButton_Click"
                                        Width="152" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="12,10" Margin="2,3" FontSize="12" MinHeight="44"
                                        Background="Transparent" BorderBrush="Transparent"
                                        AutomationProperties.AutomationId="DockSkillsButton"
                                        AutomationProperties.Name="المهارات"/>
                                <Button x:Name="DockCamerasButton" Content="◉  الكاميرات" Click="DockCamerasButton_Click"
                                        Width="152" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="12,10" Margin="2,3" FontSize="12" MinHeight="44"
                                        Background="Transparent" BorderBrush="Transparent"
                                        AutomationProperties.AutomationId="DockCamerasButton"
                                        AutomationProperties.Name="الكاميرات"/>
                                <Separator Margin="7,9"/>
                                <TextBlock Text="PERSONAL TOOLS  /  أدواتك" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Layal.Muted}" Margin="8,0,4,8"/>
                                <Button x:Name="DockMemoryButton" Content="▤  الذاكرة" Click="DockMemoryButton_Click"
                                        Width="152" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="12,10" Margin="2,3" FontSize="12" MinHeight="44"
                                        Background="Transparent" BorderBrush="Transparent"
                                        AutomationProperties.AutomationId="DockMemoryButton"
                                        AutomationProperties.Name="الذاكرة"/>
                                <Button x:Name="DockApiButton" Content="⌘  API" Click="DockApiButton_Click"
                                        Width="152" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="12,10" Margin="2,3" FontSize="12" MinHeight="44"
                                        Background="Transparent" BorderBrush="Transparent"
                                        AutomationProperties.AutomationId="DockApiButton"
                                        AutomationProperties.Name="تكاملات API"/>
                                <Button x:Name="DockSettingsButton" Content="⚙  الإعدادات" Click="DockSettingsButton_Click"
                                        Width="152" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="12,10" Margin="2,3" FontSize="12" MinHeight="44"
                                        Background="Transparent" BorderBrush="Transparent"
                                        AutomationProperties.AutomationId="DockSettingsButton"
                                        AutomationProperties.Name="الإعدادات"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                    <Border x:Name="DockFooterNote" Grid.Row="2" Margin="3,14,3,2" Padding="10"
