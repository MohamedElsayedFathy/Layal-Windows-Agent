<Window x:Class="Layal.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:controls="clr-namespace:Layal.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Layal | ليال" Icon="pack://application:,,,/Layal;component/Assets/layal-tray.ico" Width="1320" Height="860" MinWidth="900" MinHeight="560"
        Background="Transparent" Foreground="{DynamicResource Layal.Text}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" Loaded="MainWindow_Loaded" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="WindowRoot" Background="{DynamicResource Layal.AppBackdropWash}">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Layered aurora glow behind the frosted panels: decorative only, never intercepts input. -->
        <Grid x:Name="AmbientGlassLayer" Grid.Row="0" Grid.RowSpan="2"
              IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-190,-205,0,0" Fill="{DynamicResource Layal.GlowBlueBrush}" Opacity="0.54">
                
            </Ellipse>
            <Ellipse Width="440" Height="440" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-145,210,0" Fill="{DynamicResource Layal.GlowVioletBrush}" Opacity="0.46">
                
            </Ellipse>
            <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-195,-225" Fill="{DynamicResource Layal.GlowPinkBrush}" Opacity="0.38">
                
            </Ellipse>
        </Grid>
        <StackPanel x:Name="TopBarBrandRow" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
            <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource Layal.AccentGradient}" Margin="0,0,9,0">
                <TextBlock Text="L" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Layal.OnAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Layal | ليال" FontSize="14" FontWeight="SemiBold"
                           FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" Text="مساعد سطح المكتب" FontSize="10"
                           Foreground="{DynamicResource Layal.Muted}" FlowDirection="LeftToRight"/>
            </StackPanel>
        </StackPanel>
        <!-- Custom caption: the empty area remains draggable; status indicators and caption buttons stay interactive. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                    KeyboardNavigation.TabNavigation="Local">
<Border x:Name="VoiceConversationIndicator" shell:WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" CornerRadius="11"
                            Background="{DynamicResource Layal.Panel}" Padding="10,8" Margin="4"
                            BorderBrush="{DynamicResource Layal.DangerBorder}" BorderThickness="1"
                            AutomationProperties.Name="حالة الميكروفون للمحادثة الصوتية" AutomationProperties.LiveSetting="Polite">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="VoiceConversationMicDot" Width="9" Height="9" Fill="{DynamicResource Layal.Danger}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="VoiceConversationMicStatus" Text="الميكروفون نشط" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Layal.Text}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
<Border x:Name="CameraVisionIndicator" shell:WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" CornerRadius="11"
                            Background="{DynamicResource Layal.Panel}" Padding="10,8" Margin="4"
                            BorderBrush="{DynamicResource Layal.DangerBorder}" BorderThickness="1"
                            AutomationProperties.Name="حالة كاميرا الرؤية" AutomationProperties.LiveSetting="Polite">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="CameraVisionDot" Width="9" Height="9" Fill="{DynamicResource Layal.Danger}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="CameraVisionStatusText" Text="الكاميرا نشطة" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Layal.Text}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
            <Border x:Name="ConnectionStatusShell" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    CornerRadius="10" Background="{DynamicResource Layal.GlassFill}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}"
                    BorderThickness="1" Padding="8,5" Margin="3" VerticalAlignment="Center">
                <TextBlock x:Name="ConnectionStatusText" Text="AI: Not connected" Foreground="{DynamicResource Layal.Warning}"
                           FontSize="11" FontWeight="SemiBold" AutomationProperties.Name="حالة اتصال المزود"
                           AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <Button x:Name="LanguageButton" Content="English" Click="LanguageButton_Click" MinWidth="62"
                    Padding="7,5" Margin="2" FontSize="11" MinHeight="32"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="ThemeButton" Content="☾ Dark" Click="ThemeButton_Click" MinWidth="78"
                    Padding="7,5" Margin="2" FontSize="11" MinHeight="32"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="KeyboardHelpButton" Content="F1" Click="KeyboardHelpButton_Click" MinWidth="38"
                    Padding="7,5" Margin="2" FontSize="11" MinHeight="32"
                    ToolTip="اختصارات لوحة المفاتيح" AutomationProperties.Name="اختصارات لوحة المفاتيح"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="ShowMascotButton" Content="ليال" Click="ShowMascotButton_Click" MinWidth="48"
                    Padding="7,5" Margin="2" FontSize="11" MinHeight="32"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="MinimizeWindowButton" Style="{StaticResource Layal.CaptionButton}" Content="&#xE921;" Click="MinimizeWindowButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="تصغير / Minimize" AutomationProperties.Name="تصغير / Minimize" />
            <Button x:Name="MaximizeWindowButton" Style="{StaticResource Layal.CaptionButton}" Content="&#xE922;" Click="MaximizeWindowButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="تكبير أو استعادة / Maximize or restore" AutomationProperties.Name="تكبير أو استعادة / Maximize or restore" />
            <Button x:Name="CloseWindowButton" Style="{StaticResource Layal.CaptionButton}" Content="&#xE8BB;" Click="CloseWindowButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="إغلاق / Close" AutomationProperties.Name="إغلاق / Close" />
        </StackPanel>
        <controls:ContentOnlyTabControl x:Name="MainTabs" Grid.Row="1" Margin="214,10,14,12" Style="{StaticResource Layal.ContentOnlyTabControl}" Background="Transparent" BorderBrush="Transparent" KeyboardNavigation.TabNavigation="Local" SelectionChanged="MainTabs_SelectionChanged" AutomationProperties.Name="التنقل الرئيسي / Main navigation" AutomationProperties.HelpText="استخدم Ctrl+1 إلى Ctrl+8 للتنقل بين التبويبات / Use Ctrl+1 to Ctrl+8 to navigate the tabs.">
            <TabItem x:Name="HomeTab" Header="نظرة عامة" Tag="&#xE80F;">
                <Border Style="{StaticResource Layal.PageCanvas}" Margin="0,2,0,2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Layal.PageHero}" Padding="26" Margin="0,0,0,16">
                                <Grid MinHeight="190">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="210"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="700">
                                        <TextBlock Text="YOUR AI DESK  /  مساحة عملك الذكية" Style="{StaticResource Layal.SectionEyebrow}"/>
                                        <TextBlock x:Name="HomeHeading" Text="أهلًا، أنا ليال" FontWeight="SemiBold"
                                                   Margin="0,0,0,10" Style="{StaticResource Layal.PageHeading}"/>
                                        <TextBlock x:Name="HomeDescription"
                                                   Text="مساحة واحدة للمحادثة والمهام والذاكرة والأدوات. اربط مزود الذكاء الاصطناعي وابدأ من هنا."
                                                   TextWrapping="Wrap" MaxWidth="620" Style="{StaticResource Layal.PageDescription}"/>
                                        <WrapPanel Margin="0,16,0,0">
                                            <Button x:Name="GoChatButton" Content="فتح المحادثة" Click="GoChatButton_Click"
                                                    Background="{DynamicResource Layal.PrimaryButtonGradient}" MinHeight="42" Padding="20,10"/>
                                            <Button x:Name="GoSettingsButton" Content="إعداد اتصال AI" Click="GoSettingsButton_Click"
                                                    MinHeight="42" Padding="18,10"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="190" Height="176" CornerRadius="30"
                                            Background="{DynamicResource Layal.PageHeroGradient}"
                                            BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Image x:Name="HomeLayalImage" Width="176" Height="172"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Source="pack://application:,,,/Layal;component/Assets/Characters/layal-idle.png"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               IsHitTestVisible="False" Focusable="False"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Layal.DashboardCard}" MinHeight="142" Padding="16">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Layal.NavSelected}" HorizontalAlignment="Left">
                                            <TextBlock Text="✦" FontSize="18" Foreground="{DynamicResource Layal.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="CardAiTitle" Text="اتصال الذكاء الاصطناعي" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="CardAiValue" Text="غير متصل" FontSize="19" FontWeight="Bold"
                                                   Foreground="{DynamicResource Layal.Warning}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="CardAiHint" Text="أدخل عنوان API والمفتاح من الإعدادات"
                                                   FontSize="10" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Layal.DashboardCard}" MinHeight="142" Padding="16">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Layal.NavSelected}" HorizontalAlignment="Left">
                                            <TextBlock Text="◉" FontSize="17" Foreground="{DynamicResource Layal.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="CardMascotTitle" Text="الشخصية العائمة" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="CardMascotValue" Text="نافذة Windows أصلية" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource Layal.Success}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="CardMascotHint" Text="اسحب ليال على سطح المكتب، وانقر مرتين لفتح الواجهة."
                                                   FontSize="10" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Layal.DashboardCard}" MinHeight="142" Padding="16">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Layal.NavSelected}" HorizontalAlignment="Left">
                                            <TextBlock Text="⌘" FontSize="17" Foreground="{DynamicResource Layal.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="CardToolsTitle" Text="أدوات Windows" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="CardToolsValue" Text="أداة آمنة متاحة" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource Layal.Success}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="CardToolsHint" Text="يمكنك تجربة فتح المفكرة من الزر أدناه."
                                                   FontSize="10" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource Layal.DashboardCard}" MinHeight="142" Padding="16">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource Layal.NavSelected}" HorizontalAlignment="Left">
                                            <TextBlock Text="◇" FontSize="18" Foreground="{DynamicResource Layal.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="CardSkillsTitle" Text="مدير المهارات" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="CardSkillsValue" Text="استيراد ZIP مع التحقق" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource Layal.Success}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="CardSkillsHint" Text="يتم فحص SKILL.md وحفظ الحزمة دون تشغيل سكربتاتها."
                                                   FontSize="10" Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource Layal.DashboardCard}" Padding="18" Margin="4,0,4,14">
                                <StackPanel>
                                    <TextBlock Text="QUICK LAUNCH  /  وصول سريع" Style="{StaticResource Layal.SectionEyebrow}"/>
                                    <TextBlock Text="ابدأ مباشرة" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="أوامر قصيرة تفتح لك أهم أجزاء مساحة العمل." FontSize="11"
                                               Foreground="{DynamicResource Layal.Muted}" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button x:Name="OpenNotepadButton" Content="فتح المفكرة (اختبار فعلي)" Click="OpenNotepadButton_Click"
                                                Background="{DynamicResource Layal.PrimaryButtonGradient}" MinHeight="42" Padding="18,10"/>
                                        <Button Content="فتح المهام" Click="DockTasksButton_Click" MinHeight="42" Padding="18,10"/>
                                        <Button Content="فتح الذاكرة" Click="DockMemoryButton_Click" MinHeight="42" Padding="18,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Background="{DynamicResource Layal.HeaderGradient}" CornerRadius="18"
                                    Padding="16" Margin="4,0,4,0" BorderBrush="{DynamicResource Layal.Border}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="11" Background="{DynamicResource Layal.NavSelected}">
                                        <TextBlock Text="i" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Layal.Cyan}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ملاحظة حول حالة الميزات" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HomeCaveat"
                                                   Text="الوظائف غير المكتملة لن يتم عرضها كأنها تعمل: الصوت، والتحكم العام في Windows، وأتمتة المتصفح، والبث الحقيقي للكاميرات ستضاف في مراحل لاحقة."
                                                   Foreground="{DynamicResource Layal.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="HomeResult" Grid.Row="4" Text="" Foreground="{DynamicResource Layal.Success}"
                                       TextWrapping="Wrap" Margin="6,12,6,0" AutomationProperties.Name="نتيجة الإجراء"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem x:Name="ChatTab" Header="الرئيسية" Tag="&#xE8BD;">
                <Border Style="{StaticResource Layal.PageCanvas}" Margin="0,2,0,2">
<Grid x:Name="ChatTabLayout" Margin="0" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="ChatHistoryPanel" Grid.Column="0" Width="270" Visibility="Collapsed" Opacity="0"
                            Margin="0,4,8,4" Padding="12" CornerRadius="22"
                            Background="{DynamicResource Layal.GlassFill}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}"
                            BorderThickness="1" Effect="{DynamicResource Layal.CardShadow}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ChatHistoryPanelTransform" X="-10"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="3,2,3,10">
                                <Button x:Name="CloseChatHistoryButton" DockPanel.Dock="Right" Content="×" Width="32" Height="30"
                                        Padding="0" Click="CloseChatHistoryButton_Click"
                                        AutomationProperties.Name="إغلاق سجل المحادثات / Close chat history"/>
                                <TextBlock x:Name="ChatHistoryHeading" Text="المحادثات السابقة" FontSize="15"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="ChatHistoryList" ItemsSource="{Binding ChatConversations}"
                                         SelectionChanged="ChatHistorySelector_SelectionChanged"
                                         DisplayMemberPath="Title" Background="Transparent" BorderThickness="0"
                                         Padding="2" AutomationProperties.Name="سجل المحادثات"
                                         AutomationProperties.HelpText="اختر محادثة محفوظة لاستكمالها."/>
                                <TextBlock x:Name="ChatHistoryEmptyStateText" Text="لا توجد محادثات محفوظة بعد."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Layal.Muted}" TextAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChatConversations.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid x:Name="ChatConversationSurface" Grid.Column="1">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="3,0,3,10" Padding="18,14" CornerRadius="24" Background="{DynamicResource Layal.PageHeroGradient}"
                            BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="LAYAL  /  مساعد سطح المكتب" FlowDirection="RightToLeft"
                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Layal.Cyan}"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="ChatHeading" Text="المحادثة مع ليال"
                                           FontWeight="SemiBold" Style="{StaticResource Layal.PageHeading}" Margin="0,0,0,3"/>
                            </StackPanel>
                            <TextBlock x:Name="ChatProviderStatus" DockPanel.Dock="Right" Text="لا يوجد اتصال مختبَر"
                                       Foreground="{DynamicResource Layal.Warning}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="190" AutomationProperties.Name="حالة اتصال المزود"/>
                        </DockPanel>
                        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <ComboBox x:Name="ChatHistorySelector" ItemsSource="{Binding ChatConversations}" DisplayMemberPath="Title"
                                      SelectionChanged="ChatHistorySelector_SelectionChanged" Visibility="Collapsed"
                                      ToolTip="المحادثات المحفوظة" AutomationProperties.Name="المحادثات المحفوظة / Saved conversations"
                                      AutomationProperties.HelpText="اختر محادثة محفوظة لاستكمالها / Select a saved conversation to continue."/>
                            <Button x:Name="ToggleChatHistoryButton" Content="سجل المحادثات" Click="ToggleChatHistoryButton_Click"
                                    ToolTip="إظهار أو إخفاء سجل المحادثات" MinWidth="118"
                                    AutomationProperties.Name="إظهار سجل المحادثات"/>
                            <Button x:Name="CopyChatButton" Content="نسخ الشات" Click="CopyChatButton_Click"
                                    ToolTip="نسخ المحادثة كاملة إلى الحافظة"/>
                            <Button x:Name="NewConversationButton" Content="محادثة جديدة" Click="NewConversationButton_Click"/>
                            <Button x:Name="ClearSavedChatHistoryButton" Content="مسح السجل المحفوظ" Click="ClearSavedChatHistoryButton_Click"
                                    Background="{DynamicResource Layal.DangerSurface}" BorderBrush="{DynamicResource Layal.DangerBorder}"/>
                        </WrapPanel>
                    </Grid>
                            <Image Grid.Column="1" Width="76" Height="76" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Layal;component/Assets/Characters/layal-idle.png"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   IsHitTestVisible="False" Focusable="False" />
                        </Grid>
                    </Border>

                    <Border x:Name="ClockWeatherCard" Grid.Row="1" Background="{DynamicResource Layal.GlassFill}"
                                                    CornerRadius="15" Padding="5,3" Margin="3,0,3,6"
                                                    BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
                                                    Effect="{DynamicResource Layal.CardShadow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,14,0">
                                                        <TextBlock x:Name="ClockSectionTitle" Text="الوقت والتاريخ"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Layal.Muted}"/>
                                                        <TextBlock x:Name="ClockTimeText" Text="--:--:--"
                                                                   FontSize="18" FontWeight="SemiBold" Margin="0,1,0,0"
                                                                   AutomationProperties.Name="الوقت المحلي"/>
                                                        <TextBlock x:Name="CurrentDateText" Text="جارٍ تحميل التاريخ"
                                                                   FontSize="10" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Layal.Muted}" Margin="0,1,0,0"
                                                                   AutomationProperties.Name="التاريخ المحلي"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="1" Height="62"
