<Window x:Class="Layal.Views.TaskApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layal requires approval"
        Width="620" MinWidth="420" MaxWidth="760" MaxHeight="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="Transparent" Foreground="{DynamicResource Layal.Text}"
        FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="TaskApprovalWindow_PreviewKeyDown">
    <Border Margin="12" Padding="20" CornerRadius="18"
            Background="{DynamicResource Layal.GlassFill}" BorderBrush="{DynamicResource Layal.GlassBorderBrush}" BorderThickness="1"
            Effect="{StaticResource Layal.CardShadow}">
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold"
                       TextWrapping="Wrap" AutomationProperties.Name="Approval action"/>
            <TextBlock x:Name="IntroText" Margin="0,8,0,4"
                       Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap"
                       AutomationProperties.Name="Approval explanation"/>
            <ScrollViewer MaxHeight="440" MinHeight="56" Margin="0,8,0,10"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DetailsText" TextWrapping="Wrap"
                           AutomationProperties.Name="Approval details"/>
            </ScrollViewer>
            <TextBlock x:Name="EscapeHintText" Margin="0,4,0,0"
                       Foreground="{DynamicResource Layal.Muted}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="DeclineButton" Content="رفض الإجراء" Click="DeclineButton_Click"
                        IsDefault="True" Padding="14,8" MinWidth="112" Margin="0,0,8,0"
                        AutomationProperties.Name="رفض الإجراء فقط"/>
                <Button x:Name="ApproveButton" Content="موافقة" Click="ApproveButton_Click"
                        Padding="18,8" MinWidth="104" Background="{DynamicResource Layal.PrimaryButtonGradient}"
                        AutomationProperties.Name="الموافقة على الإجراء"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
