<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF process DPI awareness is intentionally declared in the manifest. WinForms is only used for tray integration, so suppress its WinForms-only manifest analyzer diagnostic in this mixed WPF host. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Layal</AssemblyName>
    <RootNamespace>Layal</RootNamespace>
    <Version>0.5.2</Version>
    <Authors>Layal Project</Authors>
    <Description>Layal bilingual Windows AI desktop companion - native desktop agent with bounded tool execution</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Microsoft.Windows.SDK.NET.Ref" Version="10.0.28000.87" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\layal-tray.ico" />
    <Resource Include="Assets\Characters\*.png" />
    <None Update="Assets\layal-mascot-reference.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
