<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Layal</AssemblyName>
    <RootNamespace>Layal</RootNamespace>
    <Version>0.5.2</Version>
    <Authors>Layal Project</Authors>
    <Description>Layal bilingual Windows AI desktop companion - native desktop agent with bounded tool execution</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\layal-tray.ico" />
    <None Update="Assets\layal-mascot-reference.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
